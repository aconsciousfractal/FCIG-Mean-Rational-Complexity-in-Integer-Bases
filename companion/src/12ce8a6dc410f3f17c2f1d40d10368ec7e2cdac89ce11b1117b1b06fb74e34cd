from pathlib import Path as _PortablePath
import importlib.util as _portable_import_util
_portable_original_file = _PortablePath(__file__).with_name('qualify_oracle.py')
_portable_previous_spec = _portable_import_util.spec_from_file_location
def _portable_spec(name, location, *args, **kwargs):
    location = _PortablePath(location)
    candidate = location.with_name("_portable_" + location.name)
    if not location.name.startswith("_portable_") and candidate.is_file():
        location = candidate
    return _portable_previous_spec(name, location, *args, **kwargs)
_portable_import_util.spec_from_file_location = _portable_spec
"""Fixed R39 arithmetic and original-state central geometry qualification."""
import hashlib
import importlib.util
import json
from math import gcd, isqrt
from pathlib import Path
import sys
OUT = Path(__file__).resolve().parent
ARITHMETIC = ((12, 2, 3, 2, 1), (18, 2, 3, 1, 2), (45, 3, 5, 2, 1), (75, 3, 5, 1, 2))
GEOMETRY = ((6, 2, 3, 1, 1), (12, 2, 3, 2, 1), (18, 2, 3, 1, 2), (20, 2, 5, 2, 1), (35, 5, 7, 1, 1), (36, 2, 3, 2, 2), (45, 3, 5, 2, 1), (50, 2, 5, 1, 2), (75, 3, 5, 1, 2), (100, 2, 5, 2, 2), (175, 5, 7, 2, 1), (225, 3, 5, 2, 2))

def need(ok, message):
    if not ok:
        raise RuntimeError(message)

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def load_oracle(path, pin):
    path = Path(path).resolve()
    need(path.parent == OUT and path.name == 'compressed_oracle.py', 'only frozen R39 oracle may be imported')
    need(sha(path.read_bytes()) == pin, 'exact oracle source SHA')
    spec = importlib.util.spec_from_file_location('r39_qualified_oracle', path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module

def divisors(profile):
    M, p, q, a, b = profile
    return sorted((p ** i * q ** j for i in range(a + 1) for j in range(b + 1)))

def check_invalid_inputs(oracle):
    bad_models = ((True, 2, 3, 2, 1, 1), (12, True, 3, 2, 1, 1), (12, 2, True, 2, 1, 1), (12, 2, 3, True, 1, 1), (12, 2, 3, 2, True, 1), (12, 2, 3, 2, 1, True), (12.0, 2, 3, 2, 1, 1), (12, 2, 3, 2, 1, 1.0), (18, 2, 3, 2, 1, 1), (20, 4, 5, 1, 1, 1), (18, 2, 9, 1, 1, 1), (12, 3, 2, 2, 1, 1), (4, 2, 2, 1, 1, 1), (3, 2, 3, 0, 1, 1), (4, 2, 3, 2, 0, 1), (6, 2, 3, -1, 1, 1), (12, 2, 3, 2, 1, 0), (12, 2, 3, 2, 1, 4), (12, 2.0, 3, 2, 1, 1), (12, 2, 3.0, 2, 1, 1), (12, 2, 3, 2.0, 1, 1), (12, 2, 3, 2, 1.0, 1), (12, 2, 3, 2, 1, -1), ('12', 2, 3, 2, 1, 1))
    good = {1: 0, 2: 0, 3: 0, 4: 0, 6: 0, 12: 0}
    bad_prefixes = (list(good.items()), {d: v for d, v in good.items() if d != 12}, {**good, 5: 0}, {True: 0, 2: 0, 3: 0, 4: 0, 6: 0, 12: 0}, {1.0: 0, 2: 0, 3: 0, 4: 0, 6: 0, 12: 0}, {'1': 0, 2: 0, 3: 0, 4: 0, 6: 0, 12: 0}, {**good, 1: True}, {**good, 1: 0.0}, {**good, 1: -1}, {**good, 2: 1}, None)
    for profile in bad_models:
        try:
            oracle.central_counts(*profile)
        except ValueError:
            pass
        else:
            raise RuntimeError('invalid central input accepted: ' + str(profile))
    for index, prefix in enumerate(bad_prefixes):
        try:
            oracle.invert_divisibility(2, 3, 2, 1, prefix)
        except ValueError:
            pass
        else:
            raise RuntimeError('invalid prefix accepted: ' + str(index))
    need(len(bad_models) == 24 and len(bad_prefixes) == 11, 'fixed invalid-input panel cardinality')
    return dict(central_rejections=24, prefix_rejections=11, total_calls=35, expected_exception='ValueError', status='PASS')

def check_arithmetic(oracle):
    rows = []
    for profile in ARITHMETIC:
        M, p, q, a, b = profile
        ds = divisors(profile)
        cases = visits = support_cases = support_visits = 0
        direct_comparisons = terminal_checks = 0
        prefix_floors = ie_floors = support_floors = 0
        for L in range(M):
            for U in range(L, M):
                prefix = {d: U // d - (L - 1) // d for d in ds}
                prefix_floors += 2 * len(ds)
                actual = oracle.invert_divisibility(p, q, a, b, prefix)
                direct = {d: 0 for d in ds}
                for s in range(L, U + 1):
                    direct[gcd(s, M)] += 1
                    visits += 1
                expected = []
                for g in ds[:-1]:
                    m = M // g
                    terms = [(1, 1)]
                    if m % p == 0:
                        terms += [(e * p, -sign) for e, sign in terms[:]]
                    if m % q == 0:
                        terms += [(e * q, -sign) for e, sign in terms[:]]
                    count = sum((sign * (U // (g * e) - (L - 1) // (g * e)) for e, sign in terms))
                    ie_floors += 2 * len(terms)
                    need(count == direct[g], 'direct/IE interval mismatch')
                    expected.append([g, count])
                    direct_comparisons += 1
                expected.append([M, direct[M]])
                terminal_checks += 1
                need(actual == expected and all((type(g) is type(c) is int for g, c in actual)), 'capped inversion mismatch ' + str((profile, L, U)))
                cases += 1
        k = isqrt(M)
        supported = [d for d in ds if 1 < d <= k]
        for L in range(1, k + 1):
            for U in range(L, k + 1):
                prefix = {d: 0 for d in ds}
                prefix[1] = U - L + 1
                for d in supported:
                    prefix[d] = U // d - (L - 1) // d
                    support_floors += 2
                actual = oracle.invert_divisibility(p, q, a, b, prefix)
                counts = {d: 0 for d in ds}
                for s in range(L, U + 1):
                    counts[gcd(s, M)] += 1
                    support_visits += 1
                need(actual == [[d, counts[d]] for d in ds], 'positive truncated-support inversion')
                support_cases += 1
        rows.append(dict(profile=list(profile), full_intervals=cases, full_direct_membership_visits=visits, full_prefix_floor_divisions=prefix_floors, proper_IE_floor_divisions=ie_floors, proper_output_comparisons=direct_comparisons, terminal_zero_checks=terminal_checks, support_intervals=support_cases, support_direct_membership_visits=support_visits, support_floor_divisions=support_floors, status='PASS'))
    totals = {key: sum((row[key] for row in rows)) for key in rows[0] if key not in ('profile', 'status')}
    need(totals['full_intervals'] == 4134 and totals['full_direct_membership_visits'] == 90869 and (totals['support_intervals'] == 73) and (totals['support_direct_membership_visits'] == 206), 'fixed R38 arithmetic panel work')
    need(totals['full_prefix_floor_divisions'] == 49608 and totals['proper_IE_floor_divisions'] == 115752 and (totals['support_floor_divisions'] == 292), 'fixed R38 floor counters')
    return dict(rows=rows, totals=totals)

def check_geometry(oracle):
    rows = []
    state_count = updates = calls = membership = comparisons = unit_tests = 0
    for profile in GEOMETRY:
        M, p, q, a, b = profile
        k = isqrt(M)
        ds = divisors(profile)
        heights = [k + 1] * M
        local_updates = 0
        units = []
        for d in range(1, k + 1):
            unit_tests += 1
            if gcd(d, M) != 1:
                continue
            units.append(d)
            for s in range(M):
                residue = s * d % M
                h = max(d, min(residue, M - residue))
                if h < heights[s]:
                    heights[s] = h
                updates += 1
                local_updates += 1
        classes = [gcd(s, M) for s in range(M)]
        need(heights[0] == 1, 'physical zero convention')
        if M % 2 == 0:
            need(heights[M // 2] == k + 1, 'even midpoint must be uncovered')
        results = []
        for T in range(1, k + 1):
            counts = {g: 0 for g in ds}
            for s, h in enumerate(heights):
                if h <= T:
                    counts[classes[s]] += 1
                membership += 1
            expected = [[g, counts[g]] for g in ds[:-1]]
            actual = oracle.central_counts(M, p, q, a, b, T)
            need(type(actual['cdf']) is int and type(actual['zero_count']) is int and (actual['zero_count'] == counts[M] == 1) and (actual['cdf'] == sum(counts.values())) and (actual['strata'] == expected) and all((type(g) is type(c) is int for g, c in actual['strata'])), 'original defining central geometry mismatch ' + str((profile, T, actual, expected)))
            need(all((c == 0 for g, c in actual['strata'] if g > T)), 'large gcd support')
            need(all((c % 2 == 0 for g, c in actual['strata'])), 'reflection pairing')
            results.append(dict(T=T, cdf=actual['cdf'], strata=expected, zero_count=1, oracle_counters=actual['counters'], interval_sha256=actual['interval_sha256']))
            calls += 1
            comparisons += len(expected)
        state_count += M
        rows.append(dict(profile=list(profile), k=k, unit_denominators=units, direct_witness_updates=local_updates, truncated_height_sha256=sha(json.dumps(heights, separators=(',', ':')).encode()), central_results=results, status='PASS'))
    need(state_count == 797 and calls == 83 and (updates == 4898) and (unit_tests == 83) and (membership == 8461) and (comparisons == 494), 'fixed geometry operation counts')
    return dict(rows=rows, original_states=state_count, oracle_calls=calls, denominator_mark_tests=unit_tests, direct_witness_updates=updates, retained_vector_threshold_membership_tests=membership, proper_stratum_equalities=comparisons, full_height_vectors_or_means_evaluated=False)

def main():
    need(len(sys.argv) == 3, 'frozen oracle path and exact SHA required')
    sys.dont_write_bytecode = True
    oracle = load_oracle(sys.argv[1], sys.argv[2])
    invalid = check_invalid_inputs(oracle)
    arithmetic = check_arithmetic(oracle)
    geometry = check_geometry(oracle)
    result = dict(status='R39_FIXED_ORACLE_QUALIFICATION_PASS', oracle_source_sha256=sys.argv[2], invalid_inputs=invalid, arithmetic=arithmetic, geometry=geometry, adaptive_panel=False, historical_sources_imported=False, branch_scientific_signs_evaluated=False, scope='Fixed arithmetic and original-state CENTRAL CDF qualification; no mean.')
    sys.stdout.write(json.dumps(result, sort_keys=True, indent=2) + '\n')
if __name__ == '__main__':
    main()
