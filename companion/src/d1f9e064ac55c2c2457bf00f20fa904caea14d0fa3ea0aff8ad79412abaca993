def need(ok, msg):
    if not ok:
        raise ValueError(msg)

def U(n, p, q):
    return n - n // p - n // q + n // (p * q)

def divisors(a, b, p, q):
    return sorted((p ** i * q ** j for i in range(a + 1) for j in range(b + 1)))

def cap(M, g, p, q):
    m = M // g
    H = (m - 1) // 2
    D = 1 if m == 2 else H if m % p == m % q == 0 else max(H, m - (q if m % p == 0 else p))
    return min(M // p, g * (m // 2), max(g, D))

def calendar(M, p, q, gs):
    k = isqrt(M)
    terminal = M // p
    ts = set(range(1, k + 1))
    t = k
    while t < terminal:
        t = min(terminal, (257 * t + 255) // 256)
        ts.add(t)
    z = isqrt(2 * M) + 1
    if z <= terminal:
        ts.add(z)
    for g in gs:
        ts.update((g, cap(M, g, p, q)))
    ts.add(terminal)
    return sorted(ts)

def counters(K):
    phi = list(range(K + 1))
    omega = [0] * (K + 1)
    for p in range(2, K + 1):
        if phi[p] == p:
            for n in range(p, K + 1, p):
                phi[n] -= phi[n] // p
                omega[n] += 1
    prefix = [1] * (K + 1)
    for n in range(1, K + 1):
        prefix[n] = prefix[n - 1] + phi[n]
    return (phi, omega, prefix)

