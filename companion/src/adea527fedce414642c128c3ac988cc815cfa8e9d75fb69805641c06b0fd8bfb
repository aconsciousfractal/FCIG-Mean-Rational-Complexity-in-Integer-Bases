        req(thresholds(M, p, r) == work['thresholds'], 'fixedcalendar')
        value = row(M, p, r, mu, phis)
        req(value['actual_convolution_updates'] <= work['convolution_updates_bound'], 'convbudget')
        req(value['candidate_pairs'] == work['candidate_pairs_exact'], 'pairbudget')
        rows.append(value)
        print('PROGRESS ' + str(i) + '/99', file=sys.stderr, flush=True)
    req(domain['small_profiles'] == [list(v) for v in VALIDATION], 'smallfixed')
    validation = [row(M, p, r, mu, phis, True) for M, p, r in VALIDATION]
    req(sum((v['candidate_pairs'] for v in rows)) == domain['candidate_pairs_exact'], 'pairtotal')
    used = {v['M'] for v in rows + validation}
    used.update((h for v in rows + validation for h, c in v['upper_histogram']))
    logs = [[h, *logticks(h)] for h in sorted(used)]
    paid = [v['M'] for v in rows if v['status'] == 'PAID']
