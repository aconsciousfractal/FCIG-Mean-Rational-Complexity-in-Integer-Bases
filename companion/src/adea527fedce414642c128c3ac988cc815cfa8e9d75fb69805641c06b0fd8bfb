    raw = (json.dumps(obj, sort_keys=True, indent=2) + '\n').encode()
    target = OUT / 'LENGTH_TWO_AGGREGATE.json'
    if target.exists():
        req(target.read_bytes() == raw, 'preserved scientific payload mismatch')
    else:
        with target.open('xb') as f:
