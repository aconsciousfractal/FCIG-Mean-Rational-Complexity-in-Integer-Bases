S = 2 ** 64
W = 2 ** 192
K = 32
SMALL = ((21, 3, 7), (63, 3, 7), (147, 3, 7), (189, 3, 7), (441, 3, 7), (22, 2, 11), (44, 2, 11), (88, 2, 11), (242, 2, 11), (484, 2, 11), (352, 2, 11), (26, 2, 13), (52, 2, 13), (104, 2, 13), (338, 2, 13), (676, 2, 13), (416, 2, 13), (18, 2, 3), (50, 2, 5))
