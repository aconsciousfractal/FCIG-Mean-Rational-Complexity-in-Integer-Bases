    obj = dict(status='E037_INDEPENDENT_PASS', payload_sha256=hashlib.sha256(raw).hexdigest(), moduli_reconstructed=3, paid=len(paid), unpaid=unpaid, independent32_log_enclosures=enclosures, small_definition_residues=3773, small_CDF_witness_checks=smallchecks, main_histogram_Q_checks=mainchecks, producer_imported=False, large_CDFs_recomputed=False, scientific_scope='Autonomous retained histogram/Q/log validation and small independent defining CDFs, not a fresh full large count audit.')
    raw = (json.dumps(obj, sort_keys=True, indent=2) + '\n').encode()
