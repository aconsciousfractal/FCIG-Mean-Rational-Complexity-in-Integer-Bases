OUT = Path(__file__).parent
ROOT = OUT.parents[1]
S = 2 ** 64

def req(ok, msg):
    if not ok:
        raise ValueError(msg)

def prime(n):
    return n >= 2 and all((n % d for d in range(2, isqrt(n) + 1)))

def validate_model(M, p, r):
    req(all((type(v) is int for v in (M, p, r))) and M > 1 and (1 < p < r), 'exact ordered positive model')
    req(prime(p) and prime(r), 'prime mark')
    n = M
    a = b = 0
    while n % p == 0:
        n //= p
        a += 1
    while n % r == 0:
        n //= r
        b += 1
    req(n == 1 and a > 0 and (b > 0), 'exact two-prime modulus')
    return (a, b)

def U(n, rad, p, r):
    return n - (n // p if rad % p == 0 else 0) - (n // r if rad % r == 0 else 0) + (n // (p * r) if rad == p * r else 0)

def radpart(m, p, r):
    return (p if m % p == 0 else 1) * (r if m % r == 0 else 1)

def phipart(m, p, r):
    value = m
    if m % p == 0:
        value -= value // p
    if m % r == 0:
        value -= value // r
    return value

def divisors(M, p, r):
    a, b = validate_model(M, p, r)
    return sorted((p ** i * r ** j for i in range(a + 1) for j in range(b + 1)))

def cap(M, g, p, r):
    m = M // g
    H = (m - 1) // 2
    rad = radpart(m, p, r)
    Dm = 1 if m == 2 else H if rad == p * r else max(H, m - (r if rad == p else p))
    return min(M // p, g * (m // 2), max(g, Dm))

def thresholds(M, p, r):
    k = isqrt(M)
    V = M // p
    ts = set(range(1, k + 1))
    t = k
    while t < V:
        t = min(V, (257 * t + 255) // 256)
        ts.add(t)
    z = isqrt(2 * M) + 1
    if z <= V:
        ts.add(z)
    for g in divisors(M, p, r):
        if g < M:
            ts.add(g)
            ts.add(cap(M, g, p, r))
    ts.add(V)
    req(min(ts) == 1 and max(ts) == V, 'thresholdrange')
    return sorted(ts)

def sieve(K):
    mu = [1] * (K + 1)
    mu[0] = 0
    phi = list(range(K + 1))
    prime = [True] * (K + 1)
    if K >= 1:
        prime[:2] = [False, False]
    for p in range(2, K + 1):
        if prime[p]:
            for n in range(p, K + 1, p):
                mu[n] *= -1
                phi[n] -= phi[n] // p
            for n in range(p * p, K + 1, p * p):
                mu[n] = 0
            for n in range(p * p, K + 1, p):
                prime[n] = False
    return (mu, phi)

def central(M, p, r, mu):
    k = isqrt(M)
    gs = [g for g in divisors(M, p, r) if g < M]
    dp = {}
    updates = 0
    for g in gs:
        if g > k:
            continue
        rad = radpart(M // g, p, r)
        delta = [0] * (k + 1)
        prev = 0
        for n in range(g, k + 1):
            value = U(n // g, rad, p, r) * U(n, p * r, p, r)
            delta[n] = value - prev
            prev = value
        bins = [0] * (k + 1)
        for e in range(1, k // g + 1):
            if gcd(e, p * r) > 1 or mu[e] == 0:
                continue
            c = mu[e]
            for n in range(g, k // e + 1):
                bins[e * n] += c * delta[n]
                updates += 1
        req(all((v >= 0 for v in bins)), 'primitive bin negative')
        dp[g] = bins
    unit = [n for n in range(1, k + 1) if gcd(n, p * r) == 1]
    js = {g: Counter() for g in dp}
    pairs = 0
    collisions = 0
    c = (M + k - 1) // k
    for d in unit:
        start = bisect_left(unit, max(1, c - d))
        for f in unit[start:]:
            pairs += 1
            if gcd(d, f) != 1:
                continue
            A0 = M * pow(f, -1, d) % d if d > 1 else 0
            E0 = (M - f * A0) // d
            lo = max(-((A0 - 1) // d), -((k - E0) // f))
            hi = min((k - A0) // d, (E0 - 1) // f)
            if lo > hi:
                continue
            req(lo == hi, 'multiple closed phases')
            A = A0 + d * lo
            E = E0 - f * lo
            req(1 <= A <= k and 1 <= E <= k and (A * f + E * d == M), 'phase')
            g = gcd(A, M)
            req(g == gcd(E, M) and g in dp, 'collision class')
            req(gcd(A, d) == gcd(E, f) == 1, 'collision primitive')
            js[g][max(A, d, E, f)] += 1
            collisions += 1
    cdfs = {}
    positive = 0
    for g, bins in dp.items():
        positive += sum(bins)
        cdf = [0] * (k + 1)
        v = 0
        for t in range(1, k + 1):
            h = 2 * bins[t] - js[g][t]
            req(h >= 0, 'CDF bin negative')
            v += h
            cdf[t] = v
        req(v <= phipart(M // g, p, r), 'central classmass')
        cdfs[g] = cdf
    req(1 + sum((v[-1] for v in cdfs.values())) == 1 + 2 * positive - collisions, 'central total')
    return (cdfs, dict(central_k=k, candidate_pairs=pairs, actual_convolution_updates=updates, primitive_positive_pairs=positive, ordered_collisions=collisions, exact_central_states=1 + sum((v[-1] for v in cdfs.values()))))

def witness(M, g, T, p, r):
    if T < g:
        return 0
    m = M // g
    if m == 2:
        return 1
    H = (m - 1) // 2
    rad = radpart(m, p, r)
    n = 2 * U(min(T, H), p * r, p, r)
    if rad == p * r:
        return n
    v = r if rad == p else p
    V = lambda x: x // v - x // (p * r)
    return n + 2 * max(0, V(H) - V(max(0, m - T - 1)))

def denomone(M, g, T, p, r):
    if T < g:
        return 0
    m = M // g
    if m == 2:
        return 1
    return 2 * U(min(T // g, (m - 1) // 2), radpart(m, p, r), p, r)

def far(M, T, p, r, phis):
    Q = (M - 1) // T
    req(T * T > 2 * M and T > 2 * Q, 'strictfar')
    ticks = centres = 0
    D = p * r
    for q in range(2, Q + 1):
        if gcd(q, D) == 1:
            continue
        j = 1 if q % D == 0 else 2
        num = 2 * phis[q] * (M - T * q) * S
        den = q * (T - j * q)
        req(num > 0 and den > 0, 'positivefar')
        ticks += (num + den - 1) // den
        centres += phis[q]
    return (min(M, ticks // S + centres), [T, Q, centres, ticks, ticks // S + centres])

def rawlog(n, K):
    z = Fraction(n - (1 << n.bit_length() - 1), n + (1 << n.bit_length() - 1))

    def series(z):
        p = z
        v = Fraction(0)
        for j in range(K):
            v += p / (2 * j + 1)
            p *= z * z
        return (2 * v, 2 * p / ((2 * K + 1) * (1 - z * z)))
    l, r = series(z)
    b, br = series(Fraction(1, 3))
    e = n.bit_length() - 1
    return (e * b + l, e * (b + br) + l + r)

@lru_cache(maxsize=None, typed=True)
def logticks(n):
    req(type(n) is int and n > 0, 'positive exact integer logarithm')
    l, u = rawlog(n, 16)
    return (l.numerator * S // l.denominator, (u.numerator * S + u.denominator - 1) // u.denominator)

def row(M, p, r, mu, phis, validation=False):
    a, b = validate_model(M, p, r)
    cdfs, stats = central(M, p, r, mu)
    k = isqrt(M)
    gs = [g for g in divisors(M, p, r) if g < M]
    classes = [(g, M // g, phipart(M // g, p, r), cap(M, g, p, r), cdfs.get(g)) for g in gs]
    ts = thresholds(M, p, r)
    last = 0
    hist = []
    farrows = []
    knots = []
    for T in ts:
        F = 1
        for g, m, mass, C, c in classes:
            cw = c[min(T, k)] if c is not None else 0
            w = witness(M, g, T, p, r)
            bcount = denomone(M, g, T, p, r)
            req(0 <= w <= mass and 0 <= bcount <= mass, 'witness classmass')
            F += max(cw, w, bcount, mass if T >= C else 0)
        req(1 <= F <= M, 'classCDF')
        if T <= k:
            req(F == 1 + sum((c[T] for c in cdfs.values())), 'central exactness after marginal merge')
        if T * T > 2 * M:
            surv, detail = far(M, T, p, r, phis)
            farrows.append(detail)
            F = max(F, M - surv)
        F = max(last, F)
        req(F <= M, 'monotoneCDF')
        if F > last:
            hist.append([T, F - last])
        knots.append([T, F])
        last = F
    req(last == M and sum((c for _, c in hist)) == M, 'complete uppermass')
    Q = 2 * sum((c * logticks(h)[1] for h, c in hist)) - M * logticks(M)[0]
    stats.update(M=M, p=p, r=r, a=a, b=b, terminal=M // p, status='PAID' if Q < 0 else 'UNPAID', upper_histogram=hist, upper_centered_numerator=Q, upper_centered_denominator=2 * M * S, gcd_caps=[[g, m, mass, C] for g, m, mass, C, c in classes], far_counts=farrows, threshold_count=len(ts), complete_true_minimum_vector=False, central_stratum_totals=[[g, c[k] if c is not None else 0] for g, m, mass, C, c in classes])
    if validation:
        stats.update(central_strata=[[g, c] for g, c in sorted(cdfs.items())], CDF_knots=knots, witness_cdfs=[[g, [witness(M, g, T, p, r) for T in range(1, M // p + 1)], [denomone(M, g, T, p, r) for T in range(1, M // p + 1)]] for g in gs])
    stats.update(central_strata=[[g, c] for g, c in sorted(cdfs.items())], CDF_knots=knots)
    return stats
