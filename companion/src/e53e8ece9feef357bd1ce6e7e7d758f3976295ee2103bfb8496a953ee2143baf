    check(1 < p < r and prime(p) and prime(r), 'ordered prime factors')
    check(B > 1 and M == B * B and (a >= 2) and (b >= 2) and (a % 2 == b % 2 == 0), 'positive square profile')
    check(B == p ** (a // 2) * r ** (b // 2) and M == p ** a * r ** b, 'full base valuations')

@lru_cache(None)
def logarithm(n):
    """Direct 32-term positive atanh fractions, not producer recurrence."""
    check(integer(n) and n >= 1, 'positive exact logarithm argument')
    exponent = n.bit_length() - 1
    binary_unit = 2 ** exponent

    def atanh_twice(a, b):
        check(integer(a) and integer(b) and (0 <= a < b), 'atanh range')
        finite = sum((Fraction(2 * a ** (2 * j + 1), (2 * j + 1) * b ** (2 * j + 1)) for j in range(LOG_COUNT)), Fraction(0))
        omitted = Fraction(2 * a ** (2 * LOG_COUNT + 1) * b * b, (2 * LOG_COUNT + 1) * b ** (2 * LOG_COUNT + 1) * (b * b - a * a))
        return (finite, finite + omitted)
    left, right = atanh_twice(n - binary_unit, n + binary_unit)
    l2, u2 = atanh_twice(1, 3)
    return (left + exponent * l2, right + exponent * u2)

def parameters_from_unit_residues(p, r):
    """Count actual sorted full-unit residues: no inclusion-exclusion floors."""
    check(prime(p) and prime(r) and (p < r), 'parameter prime pair')
    D = p * r
    residues = sorted((s for s in range(1, D) if gcd(s, D) == 1))
    density = Fraction(len(residues), D)
    check(len(residues) == (p - 1) * (r - 1), 'unit residue cardinality')
    discrepancies = [Fraction(bisect_right(residues, n)) - density * n for n in range(D)]
    high, low = (max(discrepancies), min(discrepancies))
    span = high - low + density
    primitive_constant = max(high, 2 * density - low)
    b1 = primitive_constant * density
    b0 = primitive_constant * (density + high) + density
    deleted_factor = Fraction(2) - Fraction(1, p) - Fraction(1, r)
    inverse_square_coefficient = Fraction(p - 1, p * p) + Fraction(r - 1, r * r) - Fraction(D - 1, D * D)
    E0 = deleted_factor * (density + high) + 2 * inverse_square_coefficient
    E1 = deleted_factor * density
    check(0 <= high <= 2 * density and -density <= low <= 0, 'counted unit discrepancy bounds')
    check(0 < span < 4 and 0 < primitive_constant < 3 and (b0 >= b1 >= 0) and (E0 > 0) and (E1 > 0), 'counted refined parameter range')
    values = dict(u=density, rho=Fraction(D, (p + 1) * (r + 1)), h=high, m=low, K=span, W=primitive_constant, b0=b0, b1=b1, v=deleted_factor, c0=inverse_square_coefficient, E0=E0, E1=E1)
    return (values, len(residues), D)

def tighter_bounds(B, par, alpha_low, alpha_high, ell_low, ell_high, root_low):
    density, rho = (par['u'], par['rho'])
    intercept = (alpha_low * (3 + 5 * rho) - 4 * (1 - rho) - 6 * density * density) / 8
    slope = (4 * alpha_low * rho - 2 + 3 * density * density) / 4
    lower_delta = intercept + slope * (ell_low if slope >= 0 else ell_high)
    _, upper_log = logarithm(B)
    upper_coarse = (B * (22 + 15 * upper_log) + 18 + 4 * upper_log) / (B * B)
    kappa = alpha_high * rho
    theta = alpha_high * (1 - rho)
    K, b0, b1 = (par['K'], par['b0'], par['b1'])
    deletion_error = par['E0'] + par['E1'] * upper_log
    linear = 2 * kappa + 2 * b0 - 2 * b1 + 2 * b1 * upper_log + 2 * density * K * (3 - 2 * root_low) + ell_high * (2 * kappa + b0 + b1 * upper_log + density * K) + (1 + Fraction(5, 4) * theta + 4 * deletion_error) / root_low
    quadratic = K * K * ell_high + 2 * deletion_error
    upper_refined = (B * linear + quadratic) / (B * B)
    check(upper_coarse > 0 and upper_refined > 0, 'positive independent error upper bounds')
    return (lower_delta, upper_coarse, upper_refined)

