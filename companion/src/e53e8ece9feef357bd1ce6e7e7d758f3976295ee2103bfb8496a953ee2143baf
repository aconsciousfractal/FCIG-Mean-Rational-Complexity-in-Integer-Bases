def integer(value):
    return type(value) is int

def rational(value, name):
    check(type(value) is list and len(value) == 2, name + ': rational pair')
    n, d = value
    check(integer(n) and integer(d) and (d > 0), name + ': exact numerator/positive denominator')
    check(gcd(abs(n), d) == 1, name + ': reduced representation')
    return Fraction(n, d)

def prime(value):
    return integer(value) and value >= 2 and all((value % q for q in range(2, isqrt(value) + 1)))

def model(profile):
    check(type(profile) is list and len(profile) == 6 and all((integer(x) for x in profile)), 'six exact profile integers')
