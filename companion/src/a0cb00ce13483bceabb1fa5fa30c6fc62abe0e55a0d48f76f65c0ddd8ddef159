def need(ok, message):
    if not ok:
        raise RuntimeError(message)

@lru_cache(maxsize=None)
def prime_factors(n):
    need(type(n) is int and n > 0, 'factorinput')
    out = []
    q = 2
    while q * q <= n:
        if n % q == 0:
            out.append(q)
            while n % q == 0:
                n //= q
        q += 1
    if n > 1:
        out.append(n)
    return tuple(out)

def squarefree_terms(n):
    out = [(1, 1)]
    for q in prime_factors(n):
        out += [(e * q, -sign) for e, sign in out]
    return out

def divisors(n):
    out = []
    for g in range(1, isqrt(n) + 1):
        if n % g == 0:
            out.append(g)
            if g * g != n:
                out.append(n // g)
    return sorted(out)

@lru_cache(maxsize=None)
def totient(n):
    result = n
    for q in prime_factors(n):
        result -= result // q
    return result

def farey(T):
    need(type(T) is int and T >= 1, 'exactFareyorder')
    yield (0, 1)
    a, b, c, d = (0, 1, 1, T)
    while c <= d:
        need(b * c - a * d == 1 and 1 <= d <= T and (b + d > T), 'Fareyneighborinvariant')
        yield (c, d)
        z = (T + b) // d
        a, b, c, d = (c, d, z * c - a, z * d - b)

def interval_count(L, U, g, terms):
    return sum((sign * (U // (g * e) - (L - 1) // (g * e)) for e, sign in terms))

def interval_union(M, T):
    need(type(M) is int and 1 <= T < M and (T * T <= M), 'central interval scope')
    gs = [g for g in divisors(M) if g < M]
    class_terms = {g: squarefree_terms(M // g) for g in gs}
    counts = {g: 0 for g in gs}
    visits = marked = intervals = merged = termwork = mass = 0
    digest = hashlib.sha256()
    active = None
    previous = None

    def finish(L, U):
        nonlocal merged, termwork, mass
        merged += 1
        mass += U - L + 1
        digest.update((str(L) + ',' + str(U) + '\n').encode())
        for g in gs:
            value = interval_count(L, U, g, class_terms[g])
            need(value >= 0, 'interval stratum count')
            counts[g] += value
            termwork += len(class_terms[g])
    for c, q in farey(T):
        visits += 1
        if gcd(q, M) > 1:
            continue
        marked += 1
        L = max(0, -((T - M * c) // q))
        U = min(M - 1, (M * c + T) // q)
        if L > U:
            continue
        intervals += 1
        if previous is not None:
            need(L >= previous[0] and U >= previous[1], 'ordered rounded endpoints')
        previous = (L, U)
        if active is None:
            active = (L, U)
        elif L <= active[1] + 1:
            active = (active[0], max(active[1], U))
        else:
            finish(*active)
            active = (L, U)
    if active is not None:
        finish(*active)
    need(visits == 1 + sum((totient(q) for q in range(1, T + 1))), 'completeFareyvisitcount')
    need(1 + sum(counts.values()) == mass, 'zero and disjoint strata')
    return dict(T=T, C=mass, gcd_counts=[[g, counts[g]] for g in gs], Farey_visits=visits, full_unit_centres=marked, nonempty_integer_intervals=intervals, merged_intervals=merged, interval_terms=termwork, interval_sha256=digest.hexdigest())

def local_primitive_count(M, T):
    need(2 * T * T <= M and T >= 1, 'collisionfree scope')
    value = termwork = 0
    for d in range(1, T + 1):
        if gcd(d, M) > 1:
            continue
        terms = squarefree_terms(d)
        termwork += len(terms)
        count = sum((sign * (T // e) for e, sign in terms))
        need(count >= 0, 'denominatorrowcount')
        value += count
    return dict(T=T, P=value, C=1 + 2 * value, local_floor_terms=termwork)

def defining_minima_small(M, p):
    values = [max(1, min(s, M - s)) for s in range(M)]
    for d in range(1, M // p + 1):
        if gcd(d, M) > 1:
            continue
        for s in range(M):
            A = s * d % M
            h = max(d, min(A, M - A))
            if h < values[s]:
                values[s] = h
    return values

def histogram_CDF(hist, T):
    return sum((c for h, c in hist if h <= T))

def far_fraction(M, p, r, T):
    need(T * T > 2 * M, 'strictfar')
    Q = (M - 1) // T
    need(T > 2 * Q, 'positivefar denominator')
    centres = ticks = groups = 0
    for q in range(2, Q + 1):
        if gcd(q, M) == 1:
            continue
        j = 1 if q % (p * r) == 0 else 2
        length = Fraction(2 * totient(q) * (M - T * q), q * (T - j * q))
        need(length > 0, 'positive grouped length')
        ticklength = length * S
        ticks += -(-ticklength.numerator // ticklength.denominator)
        centres += totient(q)
        groups += 1
    return ([T, Q, centres, ticks, ticks // S + centres], groups)

