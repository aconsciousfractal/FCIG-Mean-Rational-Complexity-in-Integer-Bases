def need(ok, why):
    if not ok:
        raise RuntimeError(why)

def exactint(n):
    return type(n) is int

def typed(value):
    if isinstance(value, list):
        return all((typed(v) for v in value))
    return exactint(value)

def series32(a, b):
    if a == 0:
        return (0, 0)
    lower = 0
    an = a
    bn = b
    for i in range(K):
        lower += 2 * an * W // ((2 * i + 1) * bn)
        an *= a * a
        bn *= b * b
    numerator = 2 * an * b * b * W
    denominator = (2 * K + 1) * bn * (b * b - a * a)
    remainder = (numerator + denominator - 1) // denominator
    return (lower, lower + K + remainder)
LOG2 = series32(1, 3)

def logs32(n):
    need(exactint(n) and n > 0, 'exact positive log')
    e = n.bit_length() - 1
    p = 2 ** e
    low, high = series32(n - p, n + p)
    low += e * LOG2[0]
    high += e * LOG2[1]
    return (low * S // W, (high * S + W - 1) // W)

def divisors(n):
    result = []
    for g in range(1, isqrt(n) + 1):
        if n % g == 0:
            result.append(g)
            if g * g != n:
                result.append(n // g)
    return sorted(result)

def phi(n, p, r):
    value = n
    for q in (p, r):
        if n % q == 0:
            value -= value // q
    return value

def classcap(M, g, p, r):
    m = M // g
    H = (m - 1) // 2
    if m == 2:
        delta = 1
    elif m % p == 0 and m % r == 0:
        delta = H
    elif m % p == 0:
        delta = max(H, m - r)
    else:
        delta = max(H, m - p)
    return min(M // p, g * (m // 2), max(g, delta))

def grid(M, p, r):
    k = isqrt(M)
    top = M // p
    ts = set(range(1, k + 1))
    t = k
    while t < top:
        t = min(top, -(-257 * t // 256))
        ts.add(t)
    start = isqrt(2 * M) + 1
    if start <= top:
        ts.add(start)
    for g in divisors(M):
        if g < M:
            ts.update((g, classcap(M, g, p, r)))
    ts.add(top)
    return sorted(ts)

def model(M, p, r):
    need(all((exactint(x) for x in (M, p, r))) and 1 < p < r and (M > 1), 'typedmodel')
    for q in (p, r):
        need(all((q % d for d in range(2, isqrt(q) + 1))), 'modelprime')
    n = M
    a = b = 0
    while n % p == 0:
        a += 1
        n //= p
    while n % r == 0:
        b += 1
        n //= r
    need(n == 1 and a > 0 and (b > 0), 'modulusprofile')
    return (a, b)

def definition(M):
    result = []
    for s in range(M):
        best = max(1, min(s, M - s))
        d = 1
        while d < best:
            if gcd(d, M) == 1:
                v = s * d % M
                best = min(best, max(d, min(v, M - v)))
            d += 1
        result.append(best)
    return result

def physical_heights(M, g, p, r):
    """Construct actual signed witnesses on the ORIGINAL modulus, not W floors."""
    model(M, p, r)
    need(exactint(g) and 0 < g < M and (M % g == 0), 'physical class')
    m = M // g
    out = []
    one = []
    repairs = 0
    representatives = (1,) if m == 2 else range(1, (m - 1) // 2 + 1)
    for h in representatives:
        if gcd(h, m) != 1:
            continue
        t = pow(h, -1, m)
        signed_residues = (t,) if m == 2 else (t, m - t)
        for t in signed_residues:
            s = g * t
            need(gcd(s, M) == g, 'physical gcd class')
            inverse = pow(t, -1, m)
            signed = inverse if 2 * inverse <= m else inverse - m
            d = abs(signed)
            A = g if signed > 0 else -g
            if gcd(d, M) != 1:
                d = m - d
                A = -A
                repairs += 1
            need(d > 0 and gcd(d, M) == 1 and (abs(A) == g) and ((s * d - A) % M == 0), 'physical fullmark congruence')
            out.append(max(abs(A), d))
            Aone = s if 2 * s <= M else s - M
            need((s - Aone) % M == 0 and gcd(1, M) == 1, 'physical denominator one')
            one.append(max(1, abs(Aone)))
    need(len(out) == phi(m, p, r), 'physical class mass')
    return (out, one, repairs)

def histogramCDF(hist, T):
    return sum((c for h, c in hist if h <= T))

def check_row(row, ledger):
    M = row['M']
    p = row['p']
    r = row['r']
    a, b = model(M, p, r)
    k = isqrt(M)
    need(all((exactint(row[key]) for key in ('a', 'b', 'terminal', 'threshold_count', 'upper_centered_numerator', 'upper_centered_denominator', 'central_k', 'exact_central_states', 'primitive_positive_pairs', 'ordered_collisions', 'candidate_pairs', 'actual_convolution_updates'))), 'row integer scalars')
    need((row['a'], row['b']) == (a, b) and row['central_k'] == k and (row['terminal'] == M // p), 'row profile/terminal')
    need(row['complete_true_minimum_vector'] is False, 'producer main definition flag')
    hist = row['upper_histogram']
    need(isinstance(hist, list) and hist and all((isinstance(v, list) and len(v) == 2 and typed(v) and (1 <= v[0] <= M // p) and (v[1] > 0) for v in hist)), 'histogram type/range')
    need([v[0] for v in hist] == sorted(set((v[0] for v in hist))) and sum((v[1] for v in hist)) == M, 'histogram order/mass')
    need(all((h in ledger for h, c in hist)) and M in ledger, 'ledger closure')
    Q = 2 * sum((c * ledger[h][1] for h, c in hist)) - M * ledger[M][0]
    need(Q == row['upper_centered_numerator'] and row['upper_centered_denominator'] == 2 * M * S, 'independent doubled Q')
    need(histogramCDF(hist, k) == row['exact_central_states'], 'central aggregate mass')
    need(row['exact_central_states'] == 1 + 2 * row['primitive_positive_pairs'] - row['ordered_collisions'], 'central identity summary')
    need(0 <= row['ordered_collisions'] <= row['candidate_pairs'] and row['primitive_positive_pairs'] >= 0 and (row['actual_convolution_updates'] >= 0), 'summary ranges')
    ts = grid(M, p, r)
    need(len(ts) == row['threshold_count'] and all((h in ts for h, c in hist)), 'independent schedule')
    gs = [g for g in divisors(M) if g < M]
    need(typed(row['gcd_caps']) and row['gcd_caps'] == [[g, M // g, phi(M // g, p, r), classcap(M, g, p, r)] for g in gs], 'all class caps')
    need(1 + sum((v[2] for v in row['gcd_caps'])) == M, 'disjoint classmass')
    totals = row['central_stratum_totals']
    need(typed(totals) and all((len(v) == 2 for v in totals)) and ([g for g, v in totals] == gs) and (len(gs) == (a + 1) * (b + 1) - 1), 'complete central headers')
    need(all((0 <= v <= phi(M // g, p, r) for g, v in totals)) and 1 + sum((v for g, v in totals)) == row['exact_central_states'], 'central total ranges')
    far = row['far_counts']
    need(typed(far) and all((len(v) == 5 for v in far)), 'far headers')
    need([v[0] for v in far] == [T for T in ts if T * T > 2 * M], 'complete far schedule')
    for T, q, centres, ticks, upper in far:
        need(q == (M - 1) // T and 0 <= centres <= M and (ticks >= 0) and (upper == centres + ticks // S), 'far integer accounting')
        need(histogramCDF(hist, T) >= M - min(M, upper), 'consumed histogram binds far bound')
    status = 'PAID' if Q < 0 else 'UNPAID'
    need(row['status'] == status, 'row retained sign')
    return status

def check_validation(row, ledger):
    check_row(row, ledger)
    M, p, r = (row[k] for k in ('M', 'p', 'r'))
    k = isqrt(M)
    top = M // p
    true = definition(M)
    sorted_true = sorted(true)
    strata = {}
    for s, h in enumerate(true):
        strata.setdefault(gcd(s, M), []).append(h)
    for values in strata.values():
        values.sort()
    checks = 0
    knots = row['CDF_knots']
    need(typed(knots) and all((len(v) == 2 for v in knots)) and ([T for T, F in knots] == grid(M, p, r)), 'complete small knots')
    for T, F in knots:
        need(F == histogramCDF(row['upper_histogram'], T) and F <= bisect_right(sorted_true, T), 'small true CDF bound')
        if T <= k:
            need(F == bisect_right(sorted_true, T), 'small exact central CDF')
        checks += 1
    gs = [g for g in divisors(M) if g < M]
    central = row['central_strata']
    need(typed(central) and all((len(v) == 2 for v in central)) and ([g for g, c in central] == [g for g in gs if g <= k]), 'complete small central strata')
    for g, cdf in central:
        need(len(cdf) == k + 1, 'small central array length')
        for T in range(k + 1):
            need(cdf[T] == bisect_right(strata[g], T), 'small central stratum equality')
            checks += 1
    curves = row['witness_cdfs']
    need(typed(curves) and all((len(v) == 3 for v in curves)) and ([v[0] for v in curves] == gs), 'complete small witness strata')
    for g, cw, cb in curves:
        need(len(cw) == len(cb) == top, 'small witness array lengths')
        hw, hb, _ = physical_heights(M, g, p, r)
        hw.sort()
        hb.sort()
        for T in range(1, top + 1):
            need(cw[T - 1] == bisect_right(hw, T) and cb[T - 1] == bisect_right(hb, T), 'small physical witness CDF equality')
            checks += 2
    return (checks, sorted_true)

def expected_local(marks):
    local = []
    for p, r in marks:
        for u, v in ((p, r), (r, p)):
            m = u
            while m <= 2 * v:
                m *= u
            n = sum((gcd(h, m) == 1 for h in range(1, (m - 1) // 2 + 1)))
            local.append(dict(kind='pure', p=p, r=r, M=v * m, g=v, child=m, present=u, missing=v, positive_types=n, step_tests_bound=4 * n + 3))
        n = sum((gcd(h, p * r) == 1 for h in range(1, (p * r - 1) // 2 + 1)))
        local.append(dict(kind='mixed', p=p, r=r, M=p * r, g=1, child=p * r, positive_types=n, step_tests_bound=4 * n + 3))
    single = [dict(kind='m2', p=p, r=r, M=2 * r, g=r, child=2, tests=[0, r - 1, r]) for p, r in marks if p == 2]
    return (local, single)

def check_local(records, profiles, singleton=False):
    need(len(records) == len(profiles), 'local records complete')
    steps = types = repairprofiles = 0
    keys = ('kind', 'p', 'r', 'M', 'g', 'child')
    for row, v in zip(records, profiles):
        need(set(row) == set(keys) | {'tests'} and all((row[k] == v[k] for k in keys)), 'local identity/shape')
        need(all((exactint(row[k]) for k in keys if k != 'kind')), 'local integer model')
        M, g, m, p, r = (v[k] for k in ('M', 'g', 'child', 'p', 'r'))
        need(M // g == m, 'local child')
        hw, hb, repairs = physical_heights(M, g, p, r)
        if singleton:
            need(m == 2 and len(hw) == 1 and (hw == hb == [g]), 'm2 physical atom')
            ts = v['tests']
        else:
            knots = {g}
            for h in range(1, (m - 1) // 2 + 1):
                if gcd(h, m) != 1:
                    continue
                knots.add(max(g, h if gcd(h, M) == 1 else m - h))
                knots.add(g * h)
            need(set(hw) | set(hb) <= knots, 'all physical breakpoints in fixed knots')
            ts = sorted({0} | knots | {h - 1 for h in knots})
            need(len(ts) <= v['step_tests_bound'] and len(hw) == 2 * v['positive_types'], 'local pre-sign work bound')
            if v['kind'] == 'pure':
                need(m > 2 * v['missing'] and repairs >= 2, 'both signed missing-prime repairs active')
                repairprofiles += 1
            else:
                need(repairs == 0, 'mixed child mark already complete')
        tests = row['tests']
        need(typed(tests) and all((len(t) == 3 for t in tests)) and ([t[0] for t in tests] == ts), 'complete unclipped local schedule')
        hw.sort()
        hb.sort()
        for T, cw, cb in tests:
            need(cw == bisect_right(hw, T) and cb == bisect_right(hb, T), 'physical local witness CDF equality')
        steps += len(ts)
        types += len(hw)
    return dict(curves=len(records), signed_types=types, test_steps=steps, CDF_checks=2 * steps, active_repair_profiles=repairprofiles)

