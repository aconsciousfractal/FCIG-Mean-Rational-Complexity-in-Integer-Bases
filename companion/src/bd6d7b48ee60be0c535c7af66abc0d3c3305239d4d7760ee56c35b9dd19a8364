"""R41 complete physical all-mark local controls; no original-state sweep."""
from bisect import bisect_right
import hashlib
import importlib.util
import json
from math import gcd
from pathlib import Path
import sys
OUT = Path(__file__).resolve().parent
ROOT = OUT.parents[1]
R40_REMAINING_PIN = 'ded6928b24012cbdc2c38cb8f83dda1bf1950cc1391465cbb468e84ae256a68a'
R40_REMAINING = ROOT / 'results/batch_40/REMAINING_N1.json'
R38_COST = ROOT / 'results/batch_38/resolve_cost_normal1.json'
R38_PIN = '86ce21b2bb7ea5c65aeab036ad14d89d6f221891ec9a299d088ab075eadb68fe'
SIGNED_TYPES = 5116390
STEP_BOUND = 10239280
COMPARISON_BOUND = 20478560

def need(ok, message):
    if not ok:
        raise RuntimeError(message)

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def digest(values):
    return sha(json.dumps(values, separators=(',', ':')).encode())

def pinned(path, pin):
    raw = Path(path).read_bytes()
    need(sha(raw) == pin, 'exact frozen input pin: ' + str(path))
    return json.loads(raw)

def load_core(path, pin):
    path = Path(path).resolve()
    need(path.parent == OUT and path.name == 'aggregate_core.py', 'only new frozen R41 formula source may be imported')
    need(sha(path.read_bytes()) == pin, 'exact R41 formula source pin')
    spec = importlib.util.spec_from_file_location('r41_local_formula_under_test', path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module

def validate_domain(domain):
    need(domain['schema'] == 'p72-e046-p2-domain-v1' and domain['source_r38_sha256'] == R38_PIN and (domain['source_r40_remaining_sha256'] == R40_REMAINING_PIN) and (domain['source_r39_remaining_sha256'] == '9bab00d4b77ddbc51bf9e685eead0d7b0f6f6173b670baefad09c261882614bb'), 'original complete p2 branch source chain')
    source_path = Path(domain['source_path'])
    remaining_path = Path(domain['source_remaining_path'])
    if not source_path.is_absolute():
        source_path = ROOT / source_path
    if not remaining_path.is_absolute():
        remaining_path = ROOT / remaining_path
    need(source_path.resolve() == R38_COST.resolve() and remaining_path.resolve() == R40_REMAINING.resolve(), 'exact retained policy and remaining-set locators')
    retained = pinned(R40_REMAINING, R40_REMAINING_PIN)
    cost = pinned(R38_COST, R38_PIN)
    need(retained['status'] == 'EXACT_RETAINED_OBLIGATION_SET_NOT_COUNTEREXAMPLES' and retained['moduli'] == 1901 and (retained['all_profiles_preserved'] is True) and (retained['favorable_subset_selection'] is False) and (retained['general_N1_closed'] is False), 'preserved R40 obligation scope')
    profiles = retained['remaining_profiles']
    need(profiles == sorted(profiles) and len(profiles) == 1901 and all((v[1] == 2 for v in profiles)) and (domain['profiles'] == profiles) and (domain['complement_profiles'] == []), 'entire remaining p2 domain, no selection')
    need(len({v[0] for v in profiles}) == 1901, 'unique branch moduli')
    marks = sorted({(v[1], v[2]) for v in profiles})
    need(len(marks) == 650 and all((p == 2 and q > 2 for p, q in marks)) and (domain['radicals'] == [list(v) for v in marks]), 'complete original p2 radical set')
    ordinary = domain['local_profiles']
    need(len(ordinary) == 1950, 'three ordinary physical curves per radical')
    need(ordinary == [v for v in cost['all_mark_local_policy']['profiles'] if v['p'] == 2], 'exact pinned R38 p2 ordinary policy selection')
    expected = []
    for p, q in marks:
        for u, v in ((p, q), (q, p)):
            child = u
            e = 1
            while child <= 2 * v:
                child *= u
                e += 1
            signed = child - child // u
            expected.append(dict(p=p, q=q, kind='pure', present=u, missing=v, exponent=e, child=child, original_modulus=v * child, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
        signed = (p - 1) * (q - 1)
        expected.append(dict(p=p, q=q, kind='mixed', child=p * q, original_modulus=p * q, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
    need(ordinary == expected, 'fixed minimal pure/mixed policy and source order')
    singleton = domain['local_m2_profiles']
    expected_singleton = [dict(p=p, q=q, kind='m2', child=2, original_modulus=2 * q, signed_types_exact=1, step_tests_bound=3) for p, q in marks]
    need(singleton == expected_singleton and len(singleton) == 650, 'one undoubled m2 atom per actual radical in pair order')
    records = ordinary + singleton
    need(domain['local_policy_totals'] == dict(curves=2600, ordinary_curves=1950, m2_singletons=650, signed_types=SIGNED_TYPES, step_tests_bound=STEP_BOUND, marginal_comparisons_bound=COMPARISON_BOUND), 'complete fixed local policy totals')
    need(sum((v['signed_types_exact'] for v in records)) == SIGNED_TYPES and sum((v['step_tests_bound'] for v in records)) == STEP_BOUND and (2 * STEP_BOUND == COMPARISON_BOUND), 'complete inherited control budgets')
    return records

def physical_curve(record):
    p, q, M, m = (record[k] for k in ('p', 'q', 'original_modulus', 'child'))
    g = M // m
    need(M == g * m and m >= 2, 'physical original child')
    singleton = record['kind'] == 'm2'
    need(m == 2 and p == 2 and (M == 2 * q) and (g == q) if singleton else m > 2, 'singleton or ordinary original model')
    if m > 2 and m % 2 == 0:
        need(gcd(m // 2, m) != 1, 'even midpoint is not a unit')
    witness_heights = []
    one_heights = []
    repairs = 0
    representatives = (1,) if singleton else range(1, (m - 1) // 2 + 1)
    for h in representatives:
        if gcd(h, m) != 1:
            continue
        positive_state = pow(h, -1, m)
        signed_states = (positive_state,) if singleton else (positive_state, m - positive_state)
        for t in signed_states:
            s = g * t
            need(gcd(s, M) == g, 'physical original gcd class')
            residue_inverse = pow(t, -1, m)
            signed_inverse = residue_inverse if 2 * residue_inverse <= m else residue_inverse - m
            d = abs(signed_inverse)
            A = g if signed_inverse > 0 else -g
            if gcd(d, M) != 1:
                d = m - d
                A = -A
                repairs += 1
            need(d > 0 and gcd(d, M) == 1 and (abs(A) == g) and ((s * d - A) % M == 0), 'physical repaired full-unit witness')
            witness_heights.append(max(abs(A), d))
            A_one = s if 2 * s <= M else s - M
            need((s - A_one) % M == 0, 'physical denominator-one witness')
            one_heights.append(max(1, abs(A_one)))
    need(len(witness_heights) == record['signed_types_exact'], 'every signed local type represented')
    if record['kind'] == 'pure':
        need(m > 2 * record['missing'] and repairs >= 2, 'both signed missing-prime repairs are actually exercised')
    elif singleton:
        need(repairs == 0 and witness_heights == one_heights == [g], 'physical singleton atom has exact mass one and height g')
    else:
        need(record['kind'] == 'mixed' and repairs == 0 and (g == 1), 'mixed child already has full mark')
    knots = {g} | set(witness_heights) | set(one_heights)
    tests = sorted({0} | knots | {h - 1 for h in knots})
    need(len(tests) <= record['step_tests_bound'], 'inherited complete-step allowance')
    if singleton:
        need(tests == [0, g - 1, g], 'complete undoubled singleton schedule')
    witness_heights.sort()
    one_heights.sort()
    return (g, witness_heights, one_heights, tests, repairs)

def main():
    need(len(sys.argv) == 5, 'frozen domain path/SHA and R41 formula path/SHA required')
    sys.dont_write_bytecode = True
    domain = pinned(sys.argv[1], sys.argv[2])
    records = validate_domain(domain)
    need(domain['core_sha256'] == sys.argv[4], 'local formula is the exact producer-bound core')
    core_locator = 'results/batch_41/aggregate_core.py'
    need(domain['source_pins'][core_locator] == sys.argv[4], 'domain source mapping binds the same actual core')
    core = load_core(sys.argv[3], sys.argv[4])
    rows = []
    total_types = total_steps = total_checks = pure_repairs = singleton_count = 0
    for index, record in enumerate(records):
        try:
            g, hw, hb, tests, repairs = physical_curve(record)
        except Exception as error:
            failure = dict(status='R41_LOCAL_PHYSICAL_CURVE_FAILURE', domain_sha256=sys.argv[2], formula_source_sha256=sys.argv[4], complete_policy_curves=2600, completed_curves=rows, completed_signed_types=total_types, completed_step_tests=total_steps, completed_marginal_comparisons=total_checks, failing_index=index, failing_profile=record, failing_curve_complete=False, unexecuted_curves=len(records) - index - 1, error_type=type(error).__name__, error_message=str(error), branch_paid_or_sign_claimed=False)
            sys.stdout.write(json.dumps(failure, sort_keys=True, indent=2) + '\n')
            sys.stdout.flush()
            raise
        M, p, q = (record[k] for k in ('original_modulus', 'p', 'q'))
        for T in tests:
            actual_w = core.witness(M, g, T, p, q)
            actual_b = core.denomone(M, g, T, p, q)
            expected_w = bisect_right(hw, T)
            expected_b = bisect_right(hb, T)
            if not (type(actual_w) is int and type(actual_b) is int and (actual_w == expected_w) and (actual_b == expected_b)):
                failure = dict(status='R41_LOCAL_CONTROL_MISMATCH', domain_sha256=sys.argv[2], formula_source_sha256=sys.argv[4], complete_policy_curves=2600, completed_curves=rows, failing_index=index, failing_profile=record, T=T, actual=[actual_w, actual_b], expected=[expected_w, expected_b], unexecuted_curves=len(records) - index - 1, branch_paid_or_sign_claimed=False)
                sys.stdout.write(json.dumps(failure, sort_keys=True, indent=2) + '\n')
                raise RuntimeError('physical local comparison mismatch retained in stdout')
            total_checks += 2
        total_types += len(hw)
        total_steps += len(tests)
        pure_repairs += record['kind'] == 'pure'
        singleton_count += record['kind'] == 'm2'
        rows.append(dict(profile=record, original_gcd_stratum=g, signed_types_checked=len(hw), step_tests=len(tests), marginal_comparisons=2 * len(tests), missing_prime_repairs=repairs, witness_height_sha256=digest(hw), denominator_one_height_sha256=digest(hb), complete_schedule_sha256=digest(tests), first_threshold=tests[0], last_threshold=tests[-1], status='PASS'))
    need(total_types == SIGNED_TYPES and len(rows) == 2600 and (pure_repairs == 1300) and (singleton_count == 650) and (total_steps <= STEP_BOUND) and (total_checks == 2 * total_steps <= COMPARISON_BOUND), 'complete physical policy and marginal budgets')
    result = dict(status='R41_ALL_MARK_PHYSICAL_LOCAL_CONTROLS_PASS', domain_sha256=sys.argv[2], formula_source_sha256=sys.argv[4], radical_pairs_checked=650, curves_checked=len(rows), signed_types_checked=total_types, test_steps=total_steps, marginal_comparisons=total_checks, step_tests_bound=STEP_BOUND, marginal_comparisons_bound=COMPARISON_BOUND, active_pure_repair_profiles=pure_repairs, m2_singletons=singleton_count, complete_curve_records=rows, original_state_minimum_sweeps=False, historical_modules_imported=False, full_branch_means_or_signs_evaluated=False, scope='All original-modulus local witnesses and denominator-one marginals, not defining minima.')
    sys.stdout.write(json.dumps(result, sort_keys=True, indent=2) + '\n')
if __name__ == '__main__':
    main()
