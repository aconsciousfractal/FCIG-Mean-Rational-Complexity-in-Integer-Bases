        req(thresholds(M) == work['thresholds'], 'fixed schedule')
        value = row(M, mu, phis)
        value.update(a=a, b=b)
        req(value['actual_convolution_updates'] <= work['central_convolution_updates_bound'], 'work budget')
        req(value['candidate_pairs'] == work['candidate_denominator_pairs_exact'], 'resolved exact pair budget')
        rows.append(value)
