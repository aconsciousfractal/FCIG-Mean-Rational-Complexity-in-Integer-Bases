    validation = [row(M, mu, phis, True) for M in VALIDATION]
    req(sum((x['candidate_pairs'] for x in rows)) == domain['candidate_pair_bound'], 'exact resolved pair budget')
    used = {x['M'] for x in rows + validation}
    used.update((h for x in rows + validation for h, c in x['upper_histogram']))
    logs = [[h, *logticks(h)] for h in sorted(used)]
    paid = [x['M'] for x in rows if x['status'] == 'PAID']
    unpaid = [x['M'] for x in rows if x['status'] == 'UNPAID']
    obj = dict(schema='p72-e035-aggregate-mean-v1', status='ALL_PAID' if not unpaid else 'PARTIAL', domain_sha256=DOMAIN_PIN, rows=rows, validation=validation, log_tick_ledger=logs, paid_moduli=paid, unpaid_moduli=unpaid, moduli=97, residues_swept=0, centre_phases_swept=0, work=domain | dict(rows=None, details=None), observed_candidate_pairs=sum((x['candidate_pairs'] for x in rows)), observed_convolution_updates=sum((x['actual_convolution_updates'] for x in rows)), full_minimum_vectors_main=0, small_validation_residues=1730, floating_used=False, analytic_proof_replaced=False)
    raw = (json.dumps(obj, sort_keys=True, indent=2) + '\n').encode()
    target = OUT / 'RADICAL10_AGGREGATE.json'
    if target.exists():
        req(target.read_bytes() == raw, 'preserved scientific payload differs')
    else:
        with target.open('xb') as f:
            f.write(raw)
