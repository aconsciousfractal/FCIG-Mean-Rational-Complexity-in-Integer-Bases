from pathlib import Path
import json
import math

def mobius(n):
    value = 1
    f = 2
    while f * f <= n:
        if n % f == 0:
            n //= f
            value = -value
            if n % f == 0:
                return 0
            while n % f == 0:
                n //= f
        f += 1
    return -value if n > 1 else value

def ceildiv(a, b):
    return -(-a // b)

def central(p, m, t):
    positive = sum((mobius(g) * (t // g) * (t // g - t // (p * g)) for g in range(1, t + 1) if g % p))
    collision = 0
    for b in range(1, t + 1):
        if not b % p:
            continue
        for d in range(1, t + 1):
            if not d % p or math.gcd(b, d) != 1:
                continue
            a0 = m * pow(d, -1, b) % b if b > 1 else 0
            collision += max(0, (t - a0) // b - ceildiv(m - b * t - d * a0, b * d) + 1)
    return 1 + 2 * positive - collision

def high(p, m, t):
    missing = 0
    for q in range(p, (m - 1) // t + 1, p):
        for a in range(1, q):
            if math.gcd(a, q) != 1:
                continue
            v = pow(a, -1, q)
            left = v + q * ((t - v) // q)
            right = q - v + q * ((t - q + v) // q)
            if min(left, right) <= 0:
                raise RuntimeError('nonpositive neighbor')
            alpha = (a * m * left - m + q * t) // (q * left)
            beta = ceildiv(a * m * right + m - q * t, q * right)
            missing += max(0, beta - alpha - 1)
    return m - missing

def main():
    base = Path(__file__).parent
    panel = json.loads((base / 'independent_panel.json').read_text())
    counts = {'positive_thresholds': 0, 'central': 0, 'high': 0, 'overlap': 0, 'zero_and_cap': 0}
    rows = []
    for row in panel['rows']:
        p, m, n = (row['p'], row['M'], row['N'])
        hist = dict(row['histogram'])
        total = sum(hist.values())
        if total != m:
            raise RuntimeError('oracle mass')
        covered = 0
        for t in range(1, m // 2 + 1):
            covered += hist.get(t, 0)
            checks = []
            if t * t <= m:
                checks.append(('central', central(p, m, t)))
            if t * t >= m and t < m // 2:
                checks.append(('high', high(p, m, t)))
            if t >= m // 2:
                checks.append(('zero_and_cap', m))
            for label, value in checks:
                if value != covered:
                    raise RuntimeError(f'CDF mismatch p={p!r} n={n!r} t={t!r} label={label!r} value={value!r} covered={covered!r}')
                counts[label] += 1
            if len(checks) > 1:
                counts['overlap'] += 1
            counts['positive_thresholds'] += 1
        counts['zero_and_cap'] += 1
        rows.append({'p': p, 'N': n, 'M': m, 'status': 'formula_matches_frozen_oracle'})
    result = {'status': 'PASS_BOUNDED_PRIME_CDF', 'scope': 'finite panel only; see written proof for every N', 'counts': counts, 'rows': rows}
    payload = json.dumps(result, indent=2) + '\n'
    (base / 'prime_cdf_receipt.json').write_text(payload, encoding='utf-8')
    print(payload, end='')
if __name__ == '__main__':
    main()
