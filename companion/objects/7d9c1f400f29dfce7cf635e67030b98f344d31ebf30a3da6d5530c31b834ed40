OUT = Path(__file__).parent
S = 2 ** 64
W = 2 ** 192
K = 32
MS = (12, 18, 24, 48, 54, 72, 96, 108, 144, 216)
DOMAIN_PIN = '90df0ba69208516d817b4745a516c7c514e86bd49d964bdc6983a2f37d1f86f8'

def need(ok, why):
    if not ok:
        raise RuntimeError(why)

def exactint(n):
    return type(n) is int

def series32(a, b):
    if a == 0:
        return (0, 0)
    lower = 0
    an = a
    bn = b
    for i in range(K):
        lower += 2 * an * W // ((2 * i + 1) * bn)
        an *= a * a
        bn *= b * b
    numerator = 2 * an * b * b * W
    denominator = (2 * K + 1) * bn * (b * b - a * a)
    remainder = (numerator + denominator - 1) // denominator
    return (lower, lower + K + remainder)
LOG2 = series32(1, 3)

def logs32(n):
    need(exactint(n) and n > 0, 'exact positive log')
    e = n.bit_length() - 1
    p = 2 ** e
    low, high = series32(n - p, n + p)
    low += e * LOG2[0]
    high += e * LOG2[1]
    return (low * S // W, (high * S + W - 1) // W)

def divisors(n):
    result = []
    for g in range(1, isqrt(n) + 1):
        if n % g == 0:
            result.append(g)
            if g * g != n:
                result.append(n // g)
    return sorted(result)

def phi(n):
    result = n
    if n % 2 == 0:
        result -= result // 2
    if n % 3 == 0:
        result -= result // 3
    return result

def classcap(M, g):
    m = M // g
    q = (2 if m % 2 else 1) * (3 if m % 3 else 1)
    return min(M // 2, g * (m // 2), max(g, m * q // 2))

def grid(M):
    k = isqrt(M)
    top = M // 2
    values = list(range(1, k + 1))
    t = k
    while t < top:
        t = (257 * t + 255) // 256
        values.append(min(top, t))
        if t > top:
            t = top
    values.append(top)
    T = isqrt(2 * M) + 1
    if T <= top:
        values.append(T)
    for g in divisors(M):
        if g < M:
            values.extend((g, classcap(M, g)))
    return sorted(set(values))

def definition(M):
    result = []
    for s in range(M):
        best = max(1, min(s, M - s))
        d = 1
        while d < best:
            if gcd(d, M) == 1:
                v = s * d % M
                best = min(best, max(d, min(v, M - v)))
            d += 1
        result.append(best)
    return result

def witness_heights(M, g):
    m = M // g
    out = []
    one = []
    for t in range(1, m):
        if gcd(t, m) != 1:
            continue
        v = pow(t, -1, m)
        v = v if 2 * v <= m else v - m
        d = abs(v)
        if gcd(d, 6) != 1:
            d = m - d
        need(d > 0 and gcd(d, 6) == 1, 'independent witness mark')
        out.append(max(g, d))
        one.append(max(1, g * min(t, m - t)))
    return (out, one)

def histogramCDF(hist, T):
    return sum((c for h, c in hist if h <= T))

def check_validation(row, ledger):
    M = row['M']
    k = isqrt(M)
    true = definition(M)
    checks = 0
    need(len(true) == M, 'small model mass')
    need([T for T, F in row['CDF_knots']] == grid(M), 'complete small knot schedule')
    for T, F in row['CDF_knots']:
        need(F == histogramCDF(row['upper_histogram'], T), 'small knots must bind consumed histogram')
        need(F <= sum((v <= T for v in true)), 'upper distribution small')
        if T <= k:
            need(F == sum((v <= T for v in true)), 'small central equality')
        checks += 1
    for g, cdf in row['central_strata']:
        for T in range(k + 1):
            need(cdf[T] == sum((true[s] <= T for s in range(M) if gcd(s, M) == g)), 'central stratum')
            checks += 1
    for g, cw, cb in row['witness_cdfs']:
        hw, hb = witness_heights(M, g)
        need(len(hw) == phi(M // g), 'small classmass')
        for T in range(1, M // 2 + 1):
            need(cw[T - 1] == sum((h <= T for h in hw)), 'witnessCDF exact')
            need(cb[T - 1] == sum((h <= T for h in hb)), 'denom1CDF exact')
            checks += 2
    return checks

def main():
    domainraw = (OUT / 'RADICAL6_DOMAIN.json').read_bytes()
    need(hashlib.sha256(domainraw).hexdigest() == DOMAIN_PIN, 'domain byte pin')
    domain = json.loads(domainraw)
    raw = (OUT / 'RADICAL6_AGGREGATE.json').read_bytes()
