    need(data['domain_sha256'] == DOMAIN_PIN, 'scientific domain')
    wanted = []
    for a in range(1, 24):
        for b in range(1, 15):
            M = 2 ** a * 3 ** b
            if M < 6 ** 9 and a != b and (gcd(a, b) < 6):
                wanted.append([M, 2, 3, a, b])
    wanted.sort()
    need(wanted == domain['rows'] and len(wanted) == 143, 'complete independent domain')
    need(sum((r[0] for r in wanted)) == 181525698, 'independent mass')
    led = {}
    enclosures = 0
    for n, l, u in data['log_tick_ledger']:
        need(exactint(n) and exactint(l) and exactint(u) and (n not in led) and (l <= u), 'log ledger types')
        L, U = logs32(n)
        need(l <= L and U <= u, 'independent32 interval not enclosed')
        led[n] = (l, u)
        enclosures += 1
    paid = []
    unpaid = []
    mainchecks = 0
    for profile, row in zip(wanted, data['rows']):
        M, _, _, a, b = profile
        need((row['M'], row['a'], row['b']) == (M, a, b), 'row')
        hist = row['upper_histogram']
        need(all((len(v) == 2 and exactint(v[0]) and exactint(v[1]) and (1 <= v[0] <= M // 2) and (v[1] > 0) for v in hist)), 'histogram type/range')
        need([v[0] for v in hist] == sorted(set((v[0] for v in hist))), 'histogram order')
        need(sum((v[1] for v in hist)) == M, 'histogram mass')
        need(all((h in led for h, c in hist)) and M in led, 'log ledger closure')
        Q = 2 * sum((c * led[h][1] for h, c in hist)) - M * led[M][0]
        need(Q == row['upper_centered_numerator'] and row['upper_centered_denominator'] == 2 * M * S, 'autonomous Q')
        need(histogramCDF(hist, isqrt(M)) == row['exact_central_states'], 'central aggregate mass')
        need(row['exact_central_states'] == 1 + 2 * row['primitive_positive_pairs'] - row['ordered_collisions'], 'central identity summary')
        ts = grid(M)
        need(len(ts) == row['threshold_count'], 'independent schedule')
        need(all((h in ts for h, c in hist)), 'height schedule')
        need(row['gcd_caps'] == [[g, M // g, phi(M // g), classcap(M, g)] for g in divisors(M) if g < M], 'class caps')
        need(sum((x[2] for x in row['gcd_caps'])) + 1 == M, 'disjoint classmass')
        status = 'PAID' if Q < 0 else 'UNPAID'
        need(status == row['status'], 'row sign')
        (paid if Q < 0 else unpaid).append(M)
        mainchecks += 1
    need(len(data['rows']) == 143 and paid == data['paid_moduli'] and (unpaid == data['unpaid_moduli']), 'all statuses retained')
    need([r['M'] for r in data['validation']] == list(MS), 'fixed validation')
    main_histograms = {r['M']: r['upper_histogram'] for r in data['rows']}
    for row in data['validation']:
        if row['M'] in main_histograms:
            need(row['upper_histogram'] == main_histograms[row['M']], 'small oracle must bind overlapping main histogram')
    smallchecks = sum((check_validation(row, led) for row in data['validation']))
    need(sum(MS) == 792, 'small residues')
    for x in (True, 0, -1, 1.0, Fraction(1)):
