def series(z):
    require(type(z) is F and 0 <= z <= F(1, 3), 'positive reduced atanh input')
    power, total = (z, F(0))
    for j in range(LOG_TERMS):
        total += power / (2 * j + 1)
        power *= z * z
    lower = 2 * total
    return (lower, lower + 2 * power / ((2 * LOG_TERMS + 1) * (1 - z * z)))

@lru_cache(None)
def logs(n):
