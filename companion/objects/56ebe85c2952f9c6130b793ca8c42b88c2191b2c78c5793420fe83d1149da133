def divisor_grid(p, q, a, b):
    return sorted((p ** i * q ** j for i in range(a + 1) for j in range(b + 1)))

def branch(p):
    return 'p2' if p == 2 else 'p3' if p == 3 else 'p_ge5'

def counters(row):
    M, p, q, a, b = (row[key] for key in ('M', 'p', 'q', 'a', 'b'))
    k = row['k']
    need(M == p ** a * q ** b and 1 < p < q and (a > 0) and (b > 0), 'retained original two-prime profile')
    need(gcd(a, b) == 1 and (a, b) != (1, 1), 'retained valuation scope')
    need(k == isqrt(M) and k >= 2 and (M >= 6), 'half/support scope')
    ds = divisor_grid(p, q, a, b)
    tau = len(ds)
    G = tau - 1
    S = sum((2 ** ((M // g % p == 0) + (M // g % q == 0)) for g in ds[:-1]))
    need(S == (2 * a + 1) * (2 * b + 1) - 1, 'original IE lattice identity')
    J = sum((1 < d <= k for d in ds))
    V = row['large_Farey_visits_exact']
    need(type(V) is int and V > 0 and (V % 2 == 1), 'inherited Farey parity')
    need(row['proper_strata'] == G and row['stratum_terms_per_interval'] == S, 'inherited class lattice')
