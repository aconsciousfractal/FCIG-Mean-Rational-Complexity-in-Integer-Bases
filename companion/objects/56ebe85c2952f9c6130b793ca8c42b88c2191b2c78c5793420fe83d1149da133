def local_policy(marks):
    profiles = []
    for p, q in marks:
        for u, v in ((p, q), (q, p)):
            child = u
            exponent = 1
            while child <= 2 * v:
                child *= u
                exponent += 1
            half = (child - 1) // 2
            signed = 2 * (half - half // u)
            profiles.append(dict(p=p, q=q, kind='pure', present=u, missing=v, exponent=exponent, child=child, original_modulus=v * child, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
        signed = (p - 1) * (q - 1)
        profiles.append(dict(p=p, q=q, kind='mixed', child=p * q, original_modulus=p * q, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
    m2 = sum((p == 2 for p, q in marks))
    signed = sum((row['signed_types_exact'] for row in profiles))
    steps = sum((row['step_tests_bound'] for row in profiles))
    totals = dict(distinct_radicals=len(marks), physical_curves_exact=len(profiles), signed_types_excluding_m2_exact=signed, m2_singletons_exact=m2, signed_types_including_m2_exact=signed + m2, step_tests_excluding_m2_bound=steps, m2_singleton_step_tests_bound=3 * m2, step_tests_including_m2_bound=steps + 3 * m2, marginal_comparisons_bound=2 * (steps + 3 * m2))
    return dict(policy='ALL_RETAINED_RADICALS_MINIMAL_PURE_CHILD_AND_MIXED', physical_witnesses_evaluated=False, profiles=profiles, totals=totals)

