def primes_up_to(limit):
    sieve = [True] * (limit + 1)
    sieve[0] = sieve[1] = False
    for p in range(2, isqrt(limit) + 1):
        if sieve[p]:
            for k in range(p * p, limit + 1, p):
                sieve[k] = False
    return [p for p in range(2, limit + 1) if sieve[p]]

def domain_rows():
    primes = primes_up_to(6612)
    rows = []
    for p in primes:
        if p * p >= 19600:
            break
        for r in primes:
            if r <= p:
                continue
            if p == 2:
                if r >= 6613:
                    break
            elif p * r >= 19600:
                break
            rows.append(dict(p=p, r=r, M=p * r))
    return sorted(rows, key=lambda v: v['M'])

def capped_envelope(mod, m, p, r):
    t = isqrt(2 * m) + 1
    if r <= t:
        exact, eh, evidence = mod.central(m, m)
        upper = [h or min(r, max(1, min(s, m - s))) for s, h in enumerate(exact)]
        evidence.update(cap_only_tail=True, tail_witness_checks=0, nonempty_holes=0, integer_hole_incidences=0, distinct_in_holes=0, far_threshold=t, exact_minima_scope='central window only')
    else:
        upper, h, exact, evidence = mod.envelope(m, m)
        upper = [min(v, r) for v in upper]
        evidence['cap_only_tail'] = False
    hist = Counter(upper)
    require(max(upper) <= r and len(upper) == m, 'proved least-prime cap')
    require({h: c for h, c in hist.items() if h <= isqrt(m)} == dict(Counter((h for h in exact if h))), 'cap preserves exact central window')
    return (upper, hist, exact, evidence)

def circle_witness(m, s, p):
    points = sorted(((s * i % m, i) for i in range(p)))
    choices = []
    for k, (x, i) in enumerate(points):
        y, j = points[(k + 1) % p]
        gap = y - x + (m if k == p - 1 else 0)
        b = j - i
        A = gap
        if b < 0:
            b, A = (-b, -A)
        choices.append((gap, A, b))
    gap, A, b = min(choices)
    require(1 <= b < p and gcd(b, m) == 1 and ((A - s * b) % m == 0) and (max(abs(A), b) <= m // p), 'actual circle-gap cap witness')
    return (A, b)

