K, SCALE = (16, 1 << 64)

def require(ok, message):
    if not ok:
        raise ValueError(message)

def ceildiv(a, b):
    return -(-a // b)

def atanh_log(t, terms):
    require(F(0) <= t <= F(1, 3), 'range-reduced atanh argument')
    lower, power = (F(0), t)
    for j in range(terms):
        lower += 2 * power / (2 * j + 1)
        power *= t * t
    return (lower, lower + 2 * power / ((2 * terms + 1) * (1 - t * t)))

def log_interval(n, terms=K):
    if type(n) is not int or n < 1:
        raise ValueError('log input must be a positive exact integer')
    k = n.bit_length() - 1
    t = F(n - (1 << k), n + (1 << k))
    lo, hi = atanh_log(t, terms)
    l2, u2 = atanh_log(F(1, 3), terms)
    return (k * l2 + lo, k * u2 + hi)

def log_ticks(n):
    lo, hi = log_interval(n)
    return (lo.numerator * SCALE // lo.denominator, ceildiv(hi.numerator * SCALE, hi.denominator))

def certify(hist, m):
    require(sum(hist.values()) == m and all((type(h) is int and 1 <= h <= m // 2 and (type(c) is int) and (c > 0) for h, c in hist.items())), 'histogram mass and range')
    upper_sum = sum((c * log_ticks(h)[1] for h, c in hist.items()))
    lower_m = log_ticks(m)[0]
    surplus = upper_sum - m // 2 * lower_m
    require(surplus < 0, 'finite upper-mean sign')
    return dict(log_scale=SCALE, upper_centered_log_numerator=surplus, upper_centered_log_denominator=SCALE * m, strict_negative=True, histogram=[[h, c] for h, c in sorted(hist.items())])

def mobius_table(limit):
    mu, primes, composite = ([0] * (limit + 1), [], [False] * (limit + 1))
    mu[1] = 1
    for n in range(2, limit + 1):
        if not composite[n]:
            primes.append(n)
            mu[n] = -1
        for p in primes:
            if n * p > limit:
                break
            composite[n * p] = True
            if n % p == 0:
                mu[n * p] = 0
                break
            mu[n * p] = -mu[n]
    return mu

def central(m):
    l = isqrt(m)
    heights = [0] * m
    heights[0] = 1
    units = [b for b in range(1, l + 1) if gcd(b, 6) == 1]
    pairs = 0
    for b in units:
        inv = pow(b, -1, m)
        for u in range(1, l + 1):
            if gcd(u, b) != 1:
                continue
            pairs += 1
            h = max(u, b)
            r = u * inv % m
            require((u - r * b) % m == 0, 'positive central witness')
            require((-u - -r % m * b) % m == 0, 'negative central witness')
            for residue in (r, -r % m):
                if not heights[residue] or h < heights[residue]:
                    heights[residue] = h
    collision_bins = Counter()
    for b in units:
        for d in units:
            if l * (b + d) < m or gcd(b, d) != 1:
                continue
            u0 = m * pow(d, -1, b) % b if b > 1 else 0
            lower = max(1, ceildiv(m - l * b, d))
            upper = min(l, (m - b) // d)
            u = u0 + b * ceildiv(lower - u0, b)
            if u > upper:
                continue
            e = (m - u * d) // b
            require(1 <= u <= l and 1 <= e <= l and (u * d + e * b == m), 'central collision diophantine equation')
            require(u + b > upper, 'one central collision per ordered pair')
            collision_bins[max(u, e, b, d)] += 1
    mu = mobius_table(l)
    unit_cumulative = [0] * (l + 1)
    for t in range(1, l + 1):
        unit_cumulative[t] = unit_cumulative[t - 1] + (gcd(t, 6) == 1)
    hist = Counter((h for h in heights if h))
    actual_cdf = collisions = 0
    for t in range(1, l + 1):
        p = sum((mu[g] * (t // g) * unit_cumulative[t // g] for g in range(1, t + 1) if gcd(g, 6) == 1))
        collisions += collision_bins[t]
        actual_cdf += hist[t]
        require(actual_cdf == 1 + 2 * p - collisions, 'every exact central histogram bin')
    require(p == pairs, 'primitive enumeration versus Mobius count')
    return (heights, hist, dict(central_cutoff=l, primitive_positive_pairs=pairs, central_residues=sum(hist.values()), central_thresholds=l, ordered_collisions=sum(collision_bins.values())))

def envelope(m):
    exact, exact_hist, evidence = central(m)
    t = isqrt(2 * m)
    t += t * t < 2 * m
    require(t * t > 2 * m, 'strict far-cover threshold')
    tail = [0] * m
    hole_count = incidences = candidate_checks = 0
    for q in range(2, (m - 1) // t + 1):
        if gcd(q, 6) == 1:
            continue
        for a in range(1, q):
            if gcd(a, q) != 1:
                continue
            inv = pow(a, -1, q)
            bs = []
            for v in (inv, q - inv):
                b = v + q * ((t - v) // q)
                if gcd(b, 6) != 1:
                    b -= q
                require(0 < b <= t and gcd(b, 6) == 1 and (b > t - 2 * q), 'low-center enclosing unit neighbor')
                if q % 6 == 0:
                    require(b > t - q, 'six-divisible refinement')
                bs.append(b)
            left = F(m * a, q) - F(m - q * t, q * bs[0])
            right = F(m * a, q) + F(m - q * t, q * bs[1])
            lo, hi = (left.numerator // left.denominator + 1, ceildiv(right.numerator, right.denominator) - 1)
            require(0 <= lo and hi < m, 'unclipped open integer hole')
            if lo > hi:
                continue
            hole_count += 1
            for r in range(lo, hi + 1):
                incidences += 1
                delta = m * a - q * r
                d = abs(delta)
                v = inv if delta >= 0 else q - inv
                b0 = v + q * ((m - v * (q + d)) // (q * (q + d)))
                candidates = []
                below = b0
                if below > 0 and gcd(below, 6) != 1:
                    below -= q
                if below > 0:
                    candidates.append(below)
                above = b0 + q
                if gcd(above, 6) != 1:
                    above += q
                require(above > 0, 'positive upper bracketing denominator')
                candidates.append(above)
                best = max(1, min(r, m - r))
                for b in candidates:
                    require(b > 0 and gcd(b, 6) == 1, 'positive unit tail denominator')
                    numerator = m - d * b
                    require(numerator % q == 0, 'integer determinant-one numerator')
                    num = numerator // q
                    if delta < 0:
                        num = -num
                    require((num - r * b) % m == 0, 'tail witness congruence')
                    best = min(best, max(abs(num), b))
                    candidate_checks += 1
                if not tail[r] or best < tail[r]:
                    tail[r] = best
    upper = [0] * m
    for r in range(m):
        if exact[r]:
            upper[r] = exact[r]
        elif tail[r]:
            require(tail[r] > evidence['central_cutoff'], 'central completeness versus tail witness')
            upper[r] = tail[r]
        else:
            upper[r] = min(t, max(1, min(r, m - r)))
    hist = Counter(upper)
    evidence.update(far_threshold=t, nonempty_holes=hole_count, integer_hole_incidences=incidences, tail_witness_checks=candidate_checks, distinct_in_holes=sum((h > 0 for h in tail)), exact_minima_scope='central window only')
    require({h: c for h, c in hist.items() if h <= evidence['central_cutoff']} == dict(exact_hist), 'full envelope preserves exact central histogram')
    return (upper, hist, exact, evidence)

def defining_minimum(m, r):
    best = max(1, min(r, m - r))
    for b in range(1, best + 1):
        if b >= best:
            break
        if gcd(b, 6) != 1:
            continue
        residue = r * b % m
        best = min(best, max(b, min(residue, m - residue)))
    return best

def parameters_and_log_tests():
    rejected = 0
    for value in (0, -1, True, 1.0, F(1)):
        try:
            log_interval(value)
        except ValueError:
            rejected += 1
        else:
            raise ValueError('invalid exact-log input accepted')
    for n in (1, 2, 3, 6, 36, 1296):
        lo, hi = log_interval(n)
        finer_lo, finer_hi = log_interval(n, 32)
        ticks_lo, ticks_hi = log_ticks(n)
        require(F(ticks_lo, SCALE) <= lo <= finer_lo <= finer_hi <= hi <= F(ticks_hi, SCALE), 'outward logarithm enclosure and refinement')
    zeta_upper = sum((F(1, k * k) for k in range(1, 6))) + F(2, 11)
    require(zeta_upper == F(65159, 39600) < F(33, 20), 'convex zeta upper premise')
    margin = F(2885, 521272) + F(1, 440)
    require(margin > F(1, 130), 'effective Delta rational lower')
    for x, degree, target in ((F(7, 10), 3, 2), (F(11, 10), 5, 3)):
        term = total = F(1)
        for j in range(1, degree + 1):
            term *= x / j
            total += term
        require(total > target, 'finite positive exponential premise')
    linear = F(371, 45) + F(3241, 900) + F(757, 80) + F(47, 30)
    quadratic = F(56, 45) + F(28, 5) + F(47, 15)
    error = F(23, 3000) + F(10, 3000 ** 2)
    require(linear == F(82349, 3600) < 23 and quadratic == F(449, 45) < 10, 'error coefficient rational premises')
    require(1296 ** 2 * 6 > 3000 ** 2 and error == F(6901, 900000) < F(1, 130), 'effective cutoff premise')
    require(F(1, 130) - error == F(287, 11700000), 'uniform effective negative margin')
    return dict(rejected_input_tests=rejected, exact_integer_log_tests=6, atanh_terms=K, scale=SCALE, Delta_lower=str(margin), effective_error_upper=str(error), effective_margin='287/11700000')

def main():
    raw = OLD.read_bytes()
    require(hashlib.sha256(raw).hexdigest() == PIN, 'frozen old histogram source')
    old = [r for r in json.loads(raw)['rows'] if r['base'] == 6]
    require([r['N'] for r in old] == [1, 2, 3, 4, 5] and sum((r['M'] for r in old)) == 9330, 'fixed reused histogram domain')
    premises = parameters_and_log_tests()
    validation = []
    for n in (1, 2, 3):
        m = 6 ** n
        upper, hist, exact, evidence = envelope(m)
        minima = [defining_minimum(m, r) for r in range(m)]
        require(Counter(minima) == Counter(dict(old[n - 1]['histogram'])), 'old histogram versus defining oracle')
        require(all((upper[r] >= minima[r] for r in range(m))), 'pointwise upper-height validation')
        require(all((exact[r] == (minima[r] if minima[r] <= isqrt(m) else 0) for r in range(m))), 'pointwise exact central validation')
        validation.append(dict(N=n, M=m, oracle_residues=m, **evidence))
    require(sum((r['oracle_residues'] for r in validation)) == 258, 'fixed oracle validation count')
    rows = []
    for row in old:
        rows.append(dict(N=row['N'], M=row['M'], certificate_kind='reused exact minimum histogram', **certify(Counter(dict(row['histogram'])), row['M'])))
    for n in (6, 7, 8):
        m = 6 ** n
        upper, hist, exact, evidence = envelope(m)
        rows.append(dict(N=n, M=m, certificate_kind='full upper-height envelope; central minima exact', **evidence, **certify(hist, m)))
    require(sum((r['M'] for r in rows)) == 2015538, 'all finite bridge residues')
    result = dict(status='E029_PASS', finite_lengths=list(range(1, 9)), finite_residues=2015538, old_histogram_residues=9330, new_upper_envelope_residues=2006208, independent_oracle_residues=258, new_full_minimum_vectors=0, floating_used=False, rows=rows, validation=validation, premises=premises)
    out = (json.dumps(result, indent=2) + '\n').encode()
    (OUT / 'FINITE_BRIDGE.json').write_bytes(out)
    sys.stdout.buffer.write(out)
if __name__ == '__main__':
    main()
