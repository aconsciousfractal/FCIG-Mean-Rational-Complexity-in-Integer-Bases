"""E039: exact R27 analytical bounds; no residue heights, CDF or mean sweep."""
from fractions import Fraction as F
from functools import lru_cache
import hashlib
import json
from math import gcd, isqrt
from pathlib import Path
ROOT = Path(__file__).resolve().parents[2]
SOURCE = ROOT / 'reports/batch_33/REDUCED_FRONTIER_METADATA.json'
SOURCE_PIN = '19842472214539f5a3d59031b59bc1cb55c0ad0f7540485145a4e8c2152c3442'
ZETA_TERMS = 128
LOG_TERMS = 16
SQRT_SCALE = 10 ** 15

def require(ok, message):
    if not ok:
        raise ValueError(message)

def pair(x):
    return [x.numerator, x.denominator]

def series(z):
    power, total = (z, F(0))
    for j in range(LOG_TERMS):
        total += power / (2 * j + 1)
        power *= z * z
    lower = 2 * total
    return (lower, lower + 2 * power / ((2 * LOG_TERMS + 1) * (1 - z * z)))

@lru_cache(None)
def logs(n):
    require(type(n) is int and n > 0, 'exact positive logarithm')
    e = n.bit_length() - 1
    unit = 1 << e
    lower, upper = series(F(n - unit, n + unit))
    l2, u2 = series(F(1, 3))
    return (e * l2 + lower, e * u2 + upper)

@lru_cache(None)
def parameters(p, r):
    require(type(p) is type(r) is int and 1 < p < r, 'ordered mark')
    require(all((p % d for d in range(2, isqrt(p) + 1))) and all((r % d for d in range(2, isqrt(r) + 1))), 'prime mark')
    D = p * r
    u = F((p - 1) * (r - 1), D)
    rho = F(D, (p + 1) * (r + 1))
    errors = [F(n - n // p - n // r + n // D) - u * n for n in range(D)]
    h, m = (max(errors), min(errors))
    K, W = (h - m + u, max(h, -m + 2 * u))
    b0, b1 = (W * (u + h) + u, W * u)
    v = 2 - F(1, p) - F(1, r)
    c0 = F(p - 1, p * p) + F(r - 1, r * r) - F(D - 1, D * D)
    E0, E1 = (v * (u + h) + 2 * c0, v * u)
    require(0 <= h <= 2 * u and -u <= m <= 0 and (0 < K < 4) and (0 < W < 3) and (b0 >= b1 >= 0) and (E0 > 0) and (E1 > 0), 'R27 parameter range')
    return dict(u=u, rho=rho, h=h, m=m, K=K, W=W, b0=b0, b1=b1, v=v, c0=c0, E0=E0, E1=E1)

def main():
    raw = SOURCE.read_bytes()
    require(hashlib.sha256(raw).hexdigest() == SOURCE_PIN, 'source bytes')
    profiles = json.loads(raw)['proposed_N2_profiles']
    require(len(profiles) == 454 and sum((v[1] for v in profiles)) == 159824036, 'fixed N2 domain')
    require(len({(v[2], v[3]) for v in profiles}) == 289, 'fixed marks')
    partial = sum((F(1, n * n) for n in range(1, ZETA_TERMS + 1)), F(0))
    alpha_lower = 1 / (partial + F(1, ZETA_TERMS))
    alpha_upper = 1 / (partial + F(1, ZETA_TERMS + 1))
    sqrt_lower = F(isqrt(2 * SQRT_SCALE ** 2), SQRT_SCALE)
    require(sqrt_lower * sqrt_lower < 2 and sqrt_lower > 1, 'sqrt2 lower')
    beta_upper = 3 - 2 * sqrt_lower
    ell_lower, ell_upper = logs(2)
    rows = []
    for profile in profiles:
        B, M, p, r, a, b = profile
        require(all((type(v) is int for v in profile)) and B * B == M and (M == p ** a * r ** b) and (a >= 2) and (b >= 2) and (a % 2 == b % 2 == 0), 'square profile')
        q = parameters(p, r)
        u, rho = (q['u'], q['rho'])
        constant = alpha_lower * (F(3, 8) + F(5, 8) * rho) - (1 - rho) / 2 - F(3, 4) * u * u
        coefficient = alpha_lower * rho - F(1, 2) + F(3, 4) * u * u
        delta = constant + coefficient * (ell_lower if coefficient >= 0 else ell_upper)
        _, logB = logs(B)
        coarse = (22 + 15 * logB) / B + (18 + 4 * logB) / (B * B)
        kappa, theta = (alpha_upper * rho, alpha_upper * (1 - rho))
        b0, b1, K = (q['b0'], q['b1'], q['K'])
        tail_error = q['E0'] + q['E1'] * logB
        linear = 2 * kappa + 2 * (b0 - b1) + 2 * b1 * logB + 2 * u * K * beta_upper + ell_upper / 2 * (4 * kappa + 2 * b0 + 2 * b1 * logB + 2 * u * K) + (1 + F(5, 4) * theta + 4 * tail_error) / sqrt_lower
        refined = linear / B + (K * K * ell_upper + 2 * tail_error) / (B * B)
        upper_coarse, upper_refined = (coarse - delta, refined - delta)
        upper = min(upper_coarse, upper_refined)
        rows.append(dict(profile=profile, delta_lower=pair(delta), coarse_error_upper=pair(coarse), refined_error_upper=pair(refined), mu_upper_coarse=pair(upper_coarse), mu_upper_refined=pair(upper_refined), mu_upper=pair(upper), status='ANALYTIC_PAID' if upper < 0 else 'NEEDS_FINITE'))
    paid = [v['profile'] for v in rows if v['status'] == 'ANALYTIC_PAID']
    remaining = [v['profile'] for v in rows if v['status'] == 'NEEDS_FINITE']
    marks = sorted({(v[2], v[3]) for v in profiles})
    result = dict(schema='p72-e039-analytic-n2-v1', source_sha256=SOURCE_PIN, zeta_terms=ZETA_TERMS, log_terms=LOG_TERMS, sqrt_scale=SQRT_SCALE, alpha_lower=pair(alpha_lower), alpha_upper=pair(alpha_upper), ell_lower=pair(ell_lower), ell_upper=pair(ell_upper), sqrt2_lower=pair(sqrt_lower), parameters=[dict(p=p, r=r, **{k: pair(v) for k, v in parameters(p, r).items()}) for p, r in marks], rows=rows, analytic_paid_profiles=paid, remaining_profiles=remaining, analytic_paid=len(paid), remaining=len(remaining), remaining_distinct_prime_pairs=len({(v[2], v[3]) for v in remaining}), remaining_state_mass_not_visited=sum((v[1] for v in remaining)), period_floor_entries=sum((p * r for p, r in marks)), finite_means_evaluated=False, residue_minima_evaluated=False, CDFs_evaluated=False, analytical_upper_bounds_evaluated=True, floating_used=False, all_N2_claim=not remaining)
    print(json.dumps(result, sort_keys=True, indent=2))
if __name__ == '__main__':
    main()
