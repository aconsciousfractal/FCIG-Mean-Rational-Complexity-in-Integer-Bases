def need(ok, message):
    if not ok:
        raise RuntimeError(message)

def equal(actual, expected, message):
    """Strict structural equality: bool/float must not impersonate integers."""
    need(type(actual) is type(expected), message + ': type')
    if isinstance(expected, dict):
        need(actual.keys() == expected.keys(), message + ': keys')
        for key, value in expected.items():
            equal(actual[key], value, message + '/' + str(key))
    elif isinstance(expected, list):
        need(len(actual) == len(expected), message + ': length')
        for index, value in enumerate(expected):
            equal(actual[index], value, message + '/' + str(index))
    else:
        need(actual == expected, message + ': value')

def pinned(path, digest):
    raw = path.read_bytes()
    need(hashlib.sha256(raw).hexdigest() == digest, 'input pin ' + path.name)
    return json.loads(raw)

def scalar_cost(profile, inherited):
    M, p, q, a, b = profile
    need(all((type(value) is int for value in profile)), 'profile exact integers')
    need(1 < p < q and a > 0 and (b > 0) and (M == p ** a * q ** b), 'original modulus and exponents')
    need(gcd(a, b) == 1 and (a, b) != (1, 1), 'complete retained valuation scope')
    k = isqrt(M)
    need(M >= 6 and k >= 2, 'central half scope')
    tau = (a + 1) * (b + 1)
    proper = tau - 1
    references = 4 * a * b + 2 * a + 2 * b
    supported = (tau + int(k * k == M)) // 2 - 1
    visits = inherited['large_Farey_visits_exact']
    need(type(visits) is int and visits > 0 and (visits % 2 == 1), 'inherited Farey count/parity; not recomputed')
    half = (visits + 1) // 2
    equal(inherited['k'], k, 'inherited k')
    equal(inherited['proper_strata'], proper, 'inherited proper cells')
    equal(inherited['stratum_terms_per_interval'], references, 'inherited IE terms')
    equal(inherited['large_interval_terms_bound'], visits * references, 'inherited IE bound')
    result = {'divisor_grid_cells_exact': tau, 'proper_strata_output_exact': proper, 'supported_divisor_queries_per_component_exact': supported, 'potentially_nonzero_strata_exact': supported + 1, 'forced_zero_strata_exact': proper - supported - 1, 'full_Farey_visits_exact': visits, 'half_Farey_emissions_exact': half, 'half_stopping_probe_bound': 1, 'half_candidate_inspections_bound': half + 1, 'half_mark_gcd_tests_bound': half, 'half_Farey_recurrence_floor_divisions_bound': half, 'half_endpoint_floor_divisions_bound': half * 2, 'half_nonempty_intervals_bound': half, 'half_merged_components_bound': half, 'old_interval_terms_bound': visits * references, 'old_class_floor_divisions_bound': visits * references * 2, 'full_shared_divisor_queries_bound': visits * (tau - 2), 'full_shared_class_floor_divisions_bound': visits * (tau - 2) * 2, 'full_support_divisor_queries_bound': visits * supported, 'full_support_class_floor_divisions_bound': visits * supported * 2, 'half_support_divisor_queries_bound': half * supported, 'half_support_class_floor_divisions_bound': half * supported * 2, 'half_principal_floor_divisions_bound': half * (3 + 2 * supported), 'half_divisibility_accumulator_updates_bound': half * supported, 'half_divisibility_differences_bound': half * supported, 'half_interval_mass_additions_bound': half, 'reconstruction_signed_references_bound': references, 'reconstruction_additions_subtractions_bound': references - proper, 'full_stratum_doublings_bound': supported + 1, 'divisor_accumulators_exact': supported + 1}
    need(result['half_support_class_floor_divisions_bound'] <= result['full_support_class_floor_divisions_bound'] <= result['full_shared_class_floor_divisions_bound'] <= result['old_class_floor_divisions_bound'], 'floor compression inequalities')
    return result

def sum_fields(rows):
    names = rows[0].keys()
    need(all((row.keys() == names for row in rows)), 'counter key conservation')
    return {name: sum((row[name] for row in rows)) for name in names}

def distinct_local_policy(marks):
    records = []
    for p, q in marks:
        for present, missing in ((p, q), (q, p)):
            exponent = next((e for e in range(1, (2 * missing).bit_length() + 1) if present ** e > 2 * missing))
            child = present ** exponent
            need(child > 2 * missing and child // present <= 2 * missing, 'minimal pure-child threshold')
            signed = child - child // present
            records.append(dict(p=p, q=q, kind='pure', present=present, missing=missing, exponent=exponent, child=child, original_modulus=missing * child, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
        signed = p * q - p - q + 1
        records.append(dict(p=p, q=q, kind='mixed', child=p * q, original_modulus=p * q, signed_types_exact=signed, step_tests_bound=2 * signed + 3))
    signed = sum((row['signed_types_exact'] for row in records))
    steps = 2 * signed + 3 * len(records)
    m2 = len([pair for pair in marks if pair[0] == 2])
    totals = dict(distinct_radicals=len(marks), physical_curves_exact=3 * len(marks), signed_types_excluding_m2_exact=signed, m2_singletons_exact=m2, signed_types_including_m2_exact=signed + m2, step_tests_excluding_m2_bound=steps, m2_singleton_step_tests_bound=3 * m2, step_tests_including_m2_bound=steps + 3 * m2, marginal_comparisons_bound=2 * steps + 6 * m2)
    return dict(policy='ALL_RETAINED_RADICALS_MINIMAL_PURE_CHILD_AND_MIXED', physical_witnesses_evaluated=False, profiles=records, totals=totals)

def distinct_synthetic_policy():
    rows = []
    for M, p, q, a, b in SYNTHETIC:
        k = isqrt(M)
        tau = (a + 1) * (b + 1)
        proper = tau - 1
        references = 4 * a * b + 2 * a + 2 * b
        supported = (tau + int(k * k == M)) // 2 - 1
        intervals = M * (M + 1) // 2
        short = k * (k + 1) // 2
        rows.append(dict(M=M, p=p, q=q, a=a, b=b, k=k, full_interval_cases_exact=intervals, full_direct_gcd_membership_visits_exact=M * (M + 1) * (M + 2) // 6, full_lattice_floor_divisions_bound=2 * tau * intervals, original_IE_floor_divisions_bound=2 * references * intervals, full_stratum_comparisons_exact=proper * intervals, support_interval_cases_exact=short, support_direct_gcd_membership_visits_exact=k * (k + 1) * (k + 2) // 6, support_floor_divisions_bound=2 * supported * short, support_stratum_comparisons_exact=proper * short))
    cost_rows = [{name: value for name, value in row.items() if name.endswith(('_exact', '_bound'))} for row in rows]
    return dict(profiles=[list(profile) for profile in SYNTHETIC], details=rows, totals=sum_fields(cost_rows), arithmetic_panel_executed=False, original_defining_CDFs_evaluated=False, scope='Prospective finite-difference/IE/direct-gcd arithmetic tests, not witness tests.')

