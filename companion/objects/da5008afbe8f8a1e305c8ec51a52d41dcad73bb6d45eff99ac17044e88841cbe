    need(len({row[0] for row in profiles}) == 4410, 'no duplicate original modulus')
    details = []
    for index, profile in enumerate(profiles):
        baseline = data['details'][index]
        equal([baseline[key] for key in ('M', 'p', 'q', 'a', 'b')], profile, 'baseline original model/order')
        expected = dict(profile=profile, baseline=baseline, compression=scalar_cost(profile, baseline))
        equal(result['details'][index], expected, 'complete metadata row ' + str(index))
        details.append(expected)
    inherited = {key: sum((row['baseline'][key] for row in details)) for key in data['totals']}
    equal(inherited, data['totals'], 'retained baseline sum')
    equal(result['inherited_totals'], inherited, 'all prospective inherited totals')
    equal(inherited['large_interval_terms_bound'], 586418464, 'inherited interval cost')
    equal(data['large_interval_floor_divisions_bound'], 1172836928, 'inherited floor cost')
    compression = sum_fields([row['compression'] for row in details])
    equal(result['compression_totals'], compression, 'all new aggregate counters')
    mass = sum((row[0] for row in profiles))
