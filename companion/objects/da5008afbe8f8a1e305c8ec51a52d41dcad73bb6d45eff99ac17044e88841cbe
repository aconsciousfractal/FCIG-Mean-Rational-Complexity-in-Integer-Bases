    branches = []
    for label in ('p2', 'p3', 'p_ge5'):
        subset = [row for row in details if ('p2' if row['profile'][1] == 2 else 'p3' if row['profile'][1] == 3 else 'p_ge5') == label]
        branches.append(dict(branch=label, count=len(subset), mass=sum((row['profile'][0] for row in subset)), compression_totals=sum_fields([row['compression'] for row in subset])))
    equal([{key: row[key] for key in ('branch', 'count', 'mass')} for row in branches], data['active_by_branch'], 'branch conservation')
    equal(result['active_by_branch'], branches, 'all branch counts and counters')
    equal(result['all_mark_local_policy'], distinct_local_policy(marks), 'complete distinct all-mark metadata recost')
    equal(result['synthetic_arithmetic_policy'], distinct_synthetic_policy(), 'complete prospective synthetic arithmetic counters')
