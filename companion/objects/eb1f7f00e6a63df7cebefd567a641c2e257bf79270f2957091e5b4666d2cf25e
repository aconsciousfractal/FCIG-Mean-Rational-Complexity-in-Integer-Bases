def require(condition, message):
    if not condition:
        raise ValueError(message)

def rat(value):
    require(isinstance(value, list) and len(value) == 2, 'rational pair required')
    n, d = value
    require(type(n) is int and type(d) is int and (d > 0), 'bad rational integers')
    answer = F(n, d)
    require(answer.numerator == n and answer.denominator == d, 'noncanonical rational')
    return answer

def packed(value):
    return [value.numerator, value.denominator]

def down(value):
    return F(value.numerator * GRID // value.denominator, GRID)

def up(value):
    return F(-(-value.numerator * GRID // value.denominator), GRID)

@lru_cache(None)
def log_integer(value):
    """32 positive atanh terms; exact binary reduction, outward 2^100 grid."""
    require(type(value) is int and value >= 1, 'log domain')
    if value == 1:
        return (F(0), F(0))
    exponent = value.bit_length() - 1
    reduced = F(value, 1 << exponent)
    y = (reduced - 1) / (reduced + 1)

    def series(z):
        square = z * z
        power = z
        total = F(0)
        for j in range(32):
            total += power / (2 * j + 1)
            power *= square
        lower = 2 * total
        upper = lower + 2 * power / (65 * (1 - square))
        return (lower, upper)
    l2, h2 = series(F(1, 3))
    lo, hi = series(y)
    return (down(exponent * l2 + lo), up(exponent * h2 + hi))

def constants():
    z = sum((F(1, n * n) for n in range(1, 257)), F(0))
    zlo, zhi = (down(z + F(1, 257)), up(z + F(1, 256)))
    alpha = (down(1 / zhi), up(1 / zlo))
    r = isqrt(2 * ROOT_SCALE * ROOT_SCALE)
    root = (F(r, ROOT_SCALE), F(r + 1, ROOT_SCALE))
    return {'zeta': (zlo, zhi), 'alpha': alpha, 'ln2': log_integer(2), 'sqrt2': root}

def parameters(p, q):
    """Residue form C3 on independently generated last indices of blocks."""
    D = p * q
    require(type(p) is int and type(q) is int and (1 < p < q), 'prime-mark order')
    require(all((p % d for d in range(2, isqrt(p) + 1))) and all((q % d for d in range(2, isqrt(q) + 1))), 'prime marks')
    starts = [(q * t + p - 1) // p for t in range(p + 1)]
    residue_values = [0]
    for t in range(p):
        last = min(q - 1, starts[t + 1] - 1)
        first = max(1, starts[t])
        require(first <= last and p * last // q == t, 'compressed block')
        residue_values.append(p * (p * last % q - last))
    for j in range(1, p):
        residue_values.append(q * (q * j % p - j))
    S = max(residue_values)
    u = F((p - 1) * (q - 1), D)
    sigma = F(S, D)
    h, m = (u + sigma, -sigma)
    K = h - m + u
    W = max(h, -m + 2 * u)
    v = F(2) - F(1, p) - F(1, q)
    c0 = F(p - 1, p * p) + F(q - 1, q * q) - F(D - 1, D * D)
    require(0 < sigma <= u and K == 2 * u + 2 * sigma, 'extrema range')
    require((sigma == u) == (q % p == 1), 'sigma equality criterion')
    return {'D': D, 'S': S, 'u': u, 'sigma': sigma, 'h': h, 'm': m, 'K': K, 'W': W, 'rho': F(D, (p + 1) * (q + 1)), 'v': v, 'c0': c0, 'first_b0': W + u, 'first_b1': W, 'second_b0': W * (u + h) + u, 'second_b1': W * u, 'coarse_b0': F(4), 'coarse_b1': F(3), 'E0': v * (u + h) + 2 * c0, 'E1': v * u}

def period_oracle(p, q):
    """Full-period oracle from unit indicators, never from floor counts."""
    D = p * q
    numerator_density = (p - 1) * (q - 1)
    running_units = 0
    mn = mx = nonunit_max = 0
    for n in range(D):
        unit = gcd(n, D) == 1
        if unit:
            running_units += 1
        e = D * running_units - numerator_density * n
        mn, mx = (min(mn, e), max(mx, e))
        if not unit:
            nonunit_max = max(nonunit_max, e)
    return (F(mn, D), F(mx, D), nonunit_max)

def sqrt_interval(M):
    k = isqrt(M)
    require(k * k <= M < (k + 1) * (k + 1), 'isqrt')
    r = isqrt(M * ROOT_SCALE * ROOT_SCALE)
    lo = F(r, ROOT_SCALE)
    hi = lo if r * r == M * ROOT_SCALE * ROOT_SCALE else F(r + 1, ROOT_SCALE)
    return (k, lo, hi)

def independent_bounds(M, par, c):
    """Positive-coefficient R3 evaluation plus lower S4, with own endpoints."""
    u, rho, K = (par['u'], par['rho'], par['K'])
    aL, aU = c['alpha']
    ellL, ellU = c['ln2']
    sL, _ = c['sqrt2']
    k, xL, xU = sqrt_interval(M)
    mlogL, mlogU = log_integer(M)
    logL, logU = (mlogL / 2, mlogU / 2)
    slope = aL * rho - F(1, 2) + F(3, 4) * u * u
    ell_for_delta = ellL if slope >= 0 else ellU
    deltaL = rho * (aL * F(5, 8) + F(1, 2)) + F(3, 8) * aL - F(1, 2) - F(3, 4) * u * u + slope * ell_for_delta
    kappaL, kappaU = (aL * rho, aU * rho)
    thetaU = aU * (1 - rho)
    betaU = 3 - 2 * sL
    Eupper = par['E0'] + par['E1'] * logU
    tL, tU = (xL - k, xU - k)
    require(0 <= tL <= tU < 1, 'fractional sqrt interval')
    f = lambda t: (1 - t) * (1 + 3 * t) / 2
    endpointL = max(F(0), min(f(tL), f(tU)) + tL ** 3 / xU)
    plateauL = max(F(1), 2 * k + 2 * tL - (M - k * k))
    answer = {'k': k, 'sqrt_lower': xL, 'sqrt_upper': xU, 'log_x_lower': logL, 'log_x_upper': logU, 't_lower': tL, 't_upper': tU, 'endpoint_delta_lower': endpointL, 'plateau_factor_lower': plateauL, 'delta_lower': deltaL, 'plateau_gain_lower': ellL * kappaL * plateauL / M, 'endpoint_gain_lower': 2 * kappaL * endpointL / M, 'zero_gain_lower': logL / M}
    answer['exact_tail_error_upper'] = Eupper
    answer['uniform_tail_error_upper'] = 3 + 2 * logU
    pairs = {'coarse': (F(4), F(3))}
    for primitive in ('first', 'second'):
        for tail in ('exact', 'uniform'):
            pairs[primitive + '_' + tail] = (par[primitive + '_b0'], par[primitive + '_b1'])
    for name, (b0, b1) in pairs.items():
        require(b0 >= b1 >= 0, 'primitive pair order')
        gainL = (ellL * kappaL * plateauL + 2 * kappaL * endpointL + 2 * (b0 - b1) + logL) / M
        if name == 'coarse':
            errU = (22 + 15 * logU) / xL + (18 + 4 * logU) / M
        else:
            tailupper = 3 + 2 * logU if name.endswith('_uniform') else Eupper
            central = 2 * kappaU + 2 * (b0 - b1) + 2 * b1 * logU + 2 * u * K * betaU
            plateau = ellU * (4 * kappaU + 2 * b0 + 2 * b1 * logU + 2 * u * K) / 2
            far = (1 + F(5, 4) * thetaU + 4 * tailupper) / sL
            errU = (central + plateau + far) / xL + (K * K * ellU + 2 * tailupper) / M
        answer[name + '_error_upper'] = errU
        answer[name + '_gain_lower'] = gainL
        answer[name + '_primitive_gain'] = 2 * (b0 - b1) / M
        answer[name + '_upper'] = -deltaL + errU - gainL
    answer['upper'] = min((answer[name + '_upper'] for name in pairs))
    return answer

def canonical_load(path):

    def unique_object(pairs):
        obj = {}
        for key, value in pairs:
            require(key not in obj, 'duplicate JSON key: ' + key)
            obj[key] = value
        return obj
    return json.loads(path.read_text(encoding='utf-8'), object_pairs_hook=unique_object)

